DATABASE_URL="postgresql://app:app@localhost:5432/requirement"

# Shared secret for the Vercel cron job that records the daily Home stat snapshots (#227).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`; set the real value in Vercel Production.
CRON_SECRET="local-cron-secret"

# Local AI Assistant: the Ollama server and the model it runs (`src/lib/ai.ts`). The server is on
# your machine, so there is no API key; leave the values to the defaults unless Ollama is elsewhere.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:12b"
