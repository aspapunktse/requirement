generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

enum ControlAssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
  NOT_APPLICABLE
  WAIVED
}

// The System Owner's answer to a Control's Self-Assessment Question —
// recorded alongside ControlAssessmentStatus, not a replacement for it. Yes/No/NA
// map to Fulfilled/left-open-plus-Risk/Not Applicable respectively.
enum SelfAssessmentAnswer {
  YES
  NO
  NA
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// One shared ordinal scale reused across Confidentiality, Integrity, and
// Availability — simpler to build/administer than three independent scales,
// and this app has no existing BIA/FIPS-199-style framework to match
// instead. See ADR 0003.
enum ImpactLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  TRANSFERRED
  CLOSED
}

enum UserRole {
  ADMIN
  RISK_OWNER
  SYSTEM_OWNER
  REVIEWER
  VIEWER
  // Scoped to specific Business Unit(s) and/or Framework(s) it's assigned
  // to, rather than RISK_OWNER's full cross-System visibility. Sees Risks
  // and compliance percentage for Systems within its assigned scope only,
  // read/reporting-only — does not manage Risk status. A separate role from
  // RISK_OWNER, not a replacement for it. See #55.
  BUSINESS_RISK_OWNER
  // Curates the requirement database: the Control Library and the Framework
  // catalog (Admin stays a superuser over both). Reads every System, but
  // never changes a System, its Assessments, Risks, or Assessment Queries.
  // Separate from ADMIN, who keeps users, roles, and the remaining catalogs.
  // See #71 and PRD 0001 §5.
  COMPLIANCE_MANAGER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())

  ownedSystems       System[]            @relation("SystemOwner")
  assessments        ControlAssessment[] @relation("AssessedBy")
  riskActions        Risk[]              @relation("RiskOwner")
  approvals          Approval[]
  // Business Units and Frameworks this User (as a BUSINESS_RISK_OWNER) is
  // assigned to. Independent of each other — a Business Risk Owner may own
  // Business Units, Frameworks, or both, not necessarily paired. See #55.
  businessUnitScopes BusinessUnit[]
  frameworkScopes    Framework[]         @relation("FrameworkRiskOwner")
  resolvedQueries    AssessmentQuery[]   @relation("QueryResolvedBy")
  queryMessages      QueryMessage[]
  acceptedGaps       Requirement[]       @relation("GapAcceptedBy")
}

// A system or cloud solution being onboarded into the enterprise.
model System {
  id                         String              @id @default(cuid())
  name                       String
  vendor                     String?
  description                String?
  status                     OnboardingStatus    @default(DRAFT)
  // Self-declared Impact Level on each CIA axis, independently — null means
  // "not yet classified" on that axis, distinct from LOW. Replaces the old
  // unenforced free-text dataClassification field. See ADR 0003.
  confidentialityImpactLevel ImpactLevel?
  integrityImpactLevel       ImpactLevel?
  availabilityImpactLevel    ImpactLevel?
  ownerId                    String
  owner                      User                @relation("SystemOwner", fields: [ownerId], references: [id])
  // One or more deployment facets this System spans (e.g. On-Prem, Cloud) —
  // a Hybrid System is simply one that declares more than one. See ADR 0003.
  deploymentFacets           DeploymentFacet[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  // When the System was actually marked Onboarded — distinct from Approval
  // (a judgment call) and from updatedAt (touched by unrelated edits). See
  // ADR 0001.
  onboardedAt                DateTime?

  assessments     ControlAssessment[]
  risks           Risk[]
  approvals       Approval[]
  // Centrally-managed dependencies this System declares it consumes. Purely
  // declarative in this ticket — auto-fulfilling mapped Controls is #16.
  capabilities    Capability[]
  // Business Units that consume this System (a reporting/grouping dimension
  // only), and the Framework(s) this System declares in scope. The declared
  // Framework Scope drives which Controls apply (the base Framework is
  // always in scope on top of it); see ADR 0007, which retired Regulatory
  // Overlay in its favour. Neither is Draft-locked. See #55.
  businessUnits   BusinessUnit[]
  frameworkScopes Framework[]         @relation("SystemFrameworkScope")
  // Curated log of System-lifecycle-relevant mutations, feeding the landing
  // page's "Recent updates" feed. See #58.
  changeEvents    ChangeEvent[]
}

// An admin-curated deployment classification (e.g. On-Premises Datacenter,
// Cloud IaaS/PaaS, SaaS) that determines which Controls apply to a
// System. A System declares one or more facets — Hybrid is simply a System
// with more than one declared, not its own catalog entry. See ADR 0003
// (which supersedes ADR 0002's single-select-only design).
model DeploymentFacet {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Controls scoped to this facet. A Control with no rows here at
  // all applies regardless of facet (see Control.deploymentFacets).
  controls Control[]
  systems  System[]
}

// An admin-curated, centrally-provided dependency (e.g. Active Directory,
// a central IAM/SSO platform, a central KMS) a System can declare it
// consumes. Standalone catalog concept — not a reference to any actual
// onboarded System, even if the same real-world thing is also tracked
// as a System elsewhere.
model Capability {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Controls this Capability auto-fulfills when a System declares it.
  controls                 Control[]
  // Systems that have declared this Capability as consumed.
  systems                  System[]
  // ControlAssessments currently auto-fulfilled by this Capability.
  autoFulfilledAssessments ControlAssessment[]
}

// An admin-curated organizational consumer (e.g. Finance, HR) that a System
// declares is using it. Purely a reporting/grouping dimension — has no
// effect on a System's applicable Control set. Not Draft-locked: a
// Business Unit can start or stop consuming an already-Onboarded System.
// See #55.
model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Systems this Business Unit consumes/uses.
  systems    System[]
  // Users assigned this Business Unit as (part of) their
  // BUSINESS_RISK_OWNER portfolio.
  riskOwners User[]
}

// A curated compliance standard, law or regulation (e.g. ISO/IEC 27001:2022,
// CMMC), made up of its own Requirements — the standard's line items —
// which Controls satisfy through Control Mappings (ADR 0005). Each version
// of a standard is its own Framework (name + version is unique), optionally
// linked to the one it supersedes. Exactly one Framework is the base
// Framework (ISO/IEC 27001:2022, whose Annex A seeds the base Control
// Library); "exactly one" is enforced in application code (src/lib/
// frameworks.ts), not by a partial unique index, which Prisma can't
// represent without showing up as schema drift. A Draft Framework is
// invisible to Systems until it's Published. Independently of that, a
// System's Framework Scope says which Frameworks fall within its audit/
// certification boundary (multi-select, per Framework), and a Business Risk
// Owner can be assigned Frameworks as part of their portfolio. See #55,
// #72 and PRD 0001 §7 F-FW.
model Framework {
  id                       String             @id @default(cuid())
  name                     String
  // e.g. "2022". Together with `name`, uniquely identifies the Framework.
  version                  String
  description              String?
  // Some frameworks only accept 100% Fulfilled when computing compliance
  // percentage against them — no partial credit for Waived/Not Applicable.
  strictComplianceRequired Boolean            @default(false)
  // For licensed standards the catalog holds only identifiers, titles and
  // an own-words paraphrase; QUOTABLE (e.g. EU law) may hold verbatim text.
  licensing                FrameworkLicensing @default(PARAPHRASE_ONLY)
  // True for exactly one Framework: ISO/IEC 27001:2022. Always in every
  // System's Framework Scope.
  isBase                   Boolean            @default(false)
  status                   FrameworkStatus    @default(DRAFT)
  createdAt                DateTime           @default(now())

  // The earlier version of this standard this Framework replaces, if any.
  supersedesId String?
  supersedes   Framework?  @relation("FrameworkSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Framework[] @relation("FrameworkSupersedes")

  // This Framework's own line items.
  requirements       Requirement[]
  // Supplementary Controls authored because a Requirement of this
  // Framework had no covering base Control.
  originatedControls Control[]     @relation("ControlOriginFramework")
  // Systems whose audit/certification boundary includes this Framework.
  scopedSystems      System[]      @relation("SystemFrameworkScope")
  // Users assigned this Framework as (part of) their BUSINESS_RISK_OWNER
  // portfolio.
  riskOwners         User[]        @relation("FrameworkRiskOwner")

  @@unique([name, version])
}

enum FrameworkLicensing {
  PARAPHRASE_ONLY
  QUOTABLE
}

// Draft: being authored or mapped — invisible to Systems. Published: can be
// in a System's Framework Scope and affects applicability.
enum FrameworkStatus {
  DRAFT
  PUBLISHED
}

// One line item of exactly one Framework — a clause, article or control
// objective as the standard states it (e.g. ISO 27001 A.8.24). Never
// assessed directly: it is satisfied through the Controls mapped to it (see
// ControlMapping), and its status for a System is derived from theirs. See
// ADR 0005.
model Requirement {
  id               String    @id @default(cuid())
  frameworkId      String
  framework        Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  // The standard's own identifier, e.g. "A.8.24" or "Art. 21(2)(h)".
  // Unique within its Framework.
  code             String
  // Grouping label, e.g. "A.8 Technological".
  section          String
  title            String
  // For PARAPHRASE_ONLY Frameworks, an own-words paraphrase — never
  // verbatim text.
  text             String
  // Gap acceptance (PRD 0001 F-CL.5): a Compliance Manager/Admin accepted
  // that this Requirement stays a Coverage Gap, with a justification. All
  // three are set together or all null (the acceptor becomes null if that
  // User is deleted). Only meaningful while the
  // Requirement is a gap; gaining a Full mapping clears them.
  gapAcceptedAt    DateTime?
  gapAcceptedById  String?
  gapAcceptedBy    User?     @relation("GapAcceptedBy", fields: [gapAcceptedById], references: [id], onDelete: SetNull)
  gapJustification String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mappings ControlMapping[]

  @@unique([frameworkId, code])
}

enum ControlCoverage {
  FULL
  PARTIAL
}

// A many-to-many link between one Requirement and one Control, carrying how
// much of the Requirement the Control covers. A Requirement is covered only
// when its mapped Controls together give FULL coverage; one with no
// mappings, or only PARTIAL ones, is a Coverage Gap. See ADR 0005.
model ControlMapping {
  id            String          @id @default(cuid())
  requirementId String
  requirement   Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  controlId     String
  control       Control         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  coverage      ControlCoverage
  rationale     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([requirementId, controlId])
  @@index([controlId])
}

enum ControlApplicability {
  ORGANIZATIONAL
  PER_SYSTEM
  BOTH
}

// A reusable control definition (security, legal, compliance, operational, etc.)
model Control {
  id            String               @id @default(cuid())
  code          String               @unique // e.g. SEC-001
  title         String
  description   String
  category      String // e.g. Security, Privacy, Legal, Operational
  mandatory     Boolean              @default(true)
  applicability ControlApplicability
  question      String? // self-assessment question; null for ORGANIZATIONAL-only controls
  intent        String? // why the question matters, shown alongside it
  examples      String[] // example ways to satisfy the control
  createdAt     DateTime             @default(now())

  assessments ControlAssessment[]

  // Deployment Facets this Control is scoped to. Empty means "applies
  // regardless of facet" (how the Annex A seed ships). Must stay empty for
  // ORGANIZATIONAL controls, which are never assessed per System.
  deploymentFacets              DeploymentFacet[]
  // Minimum required Impact Level on each CIA axis, independently — null
  // means no threshold on that axis. A Control can combine thresholds
  // on one, two, or all three axes; each is a "System's level on this axis
  // must be >= this" comparison, not a membership check like facet
  // scoping. See ADR 0003.
  minConfidentialityImpactLevel ImpactLevel?
  minIntegrityImpactLevel       ImpactLevel?
  minAvailabilityImpactLevel    ImpactLevel?
  // Capabilities that, if a System declares one, auto-fulfill this
  // Control. May be empty, one, or several (any one suffices).
  capabilities                  Capability[]
  // Which Requirements this Control satisfies, and how fully. The only way
  // a Control is tied to a Framework — there is no direct Framework tag
  // (ADR 0005, was `frameworks` before #72).
  mappings                      ControlMapping[]
  // Set: a Supplementary Control, authored because a Requirement of this
  // Framework had no covering base Control. Null: a base Control (seeded
  // 1:1 from ISO 27001:2022 Annex A).
  originFrameworkId             String?
  originFramework               Framework?          @relation("ControlOriginFramework", fields: [originFrameworkId], references: [id], onDelete: Restrict)
}

// Fulfillment status of a Control for a specific System.
model ControlAssessment {
  id                      String                  @id @default(cuid())
  systemId                String
  system                  System                  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  controlId               String
  control                 Control                 @relation(fields: [controlId], references: [id])
  status                  ControlAssessmentStatus @default(NOT_STARTED)
  evidence                String? // link or note to supporting evidence
  notes                   String?
  // The System Owner's Yes/No/N/A answer to the Control's Self-
  // Assessment Question, if it's been answered. Distinct from `status`:
  // both are shown, and manual status edits don't touch this field.
  selfAssessmentAnswer    SelfAssessmentAnswer?
  assessedById            String?
  assessedBy              User?                   @relation("AssessedBy", fields: [assessedById], references: [id])
  assessedAt              DateTime?
  updatedAt               DateTime                @updatedAt
  // Set when this Assessment was auto-fulfilled by a declared Capability
  // (see #16) rather than by a human. Non-null means "eligible for
  // automatic reversion if that Capability is un-declared" — any manual
  // edit to this Assessment clears it, which is what makes the row immune
  // to future automatic reversion and marks it as human-owned going forward.
  fulfilledByCapabilityId String?
  fulfilledByCapability   Capability?             @relation(fields: [fulfilledByCapabilityId], references: [id])

  // Risks auto-opened by answering "No" to this Control's Self-
  // Assessment Question.
  originatedRisks Risk[]
  // Assessment Queries raised against this Assessment specifically (see
  // #56) — a lightweight, non-blocking question/reply thread, distinct from
  // both the Self-Assessment Question above and Approval.comment.
  queries         AssessmentQuery[]

  @@unique([systemId, controlId])
}

// A lightweight, non-blocking question/reply thread scoped to one specific
// ControlAssessment (see #56) — lets a REVIEWER/RISK_OWNER/ADMIN push
// back on one Control without a whole-System Rejection. Purely
// informational: it never touches the Assessment's status, gates Approval,
// or affects the mandatory-Control submission check. `resolved` is an
// explicit judgment call by a REVIEWER/RISK_OWNER/ADMIN (not the System
// Owner, and not necessarily the original asker) — see `lastMessageAuthorId`
// below for the "whose turn is it" logic the various open-Query counters use.
model AssessmentQuery {
  id                  String            @id @default(cuid())
  controlAssessmentId String
  controlAssessment   ControlAssessment @relation(fields: [controlAssessmentId], references: [id], onDelete: Cascade)
  resolved            Boolean           @default(false)
  resolvedById        String?
  resolvedBy          User?             @relation("QueryResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt          DateTime?
  createdAt           DateTime          @default(now())
  // Denormalized copy of the most recent QueryMessage's authorId, kept in
  // sync on every new message. Lets "is it the System Owner's turn, or the
  // reviewer side's?" be answered with a plain field comparison instead of a
  // subquery against QueryMessage every time a counter is computed.
  lastMessageAuthorId String

  messages QueryMessage[]
}

// One turn within an AssessmentQuery thread — either the question that
// opened it or a later reply. No separate subject/title on the thread
// itself; it's identified by the Control it's attached to plus this
// message's own text.
model QueryMessage {
  id                String          @id @default(cuid())
  assessmentQueryId String
  assessmentQuery   AssessmentQuery @relation(fields: [assessmentQueryId], references: [id], onDelete: Cascade)
  authorId          String
  author            User            @relation(fields: [authorId], references: [id])
  body              String
  createdAt         DateTime        @default(now())
}

// A risk identified during onboarding of a System.
model Risk {
  id             String       @id @default(cuid())
  systemId       String
  system         System       @relation(fields: [systemId], references: [id], onDelete: Cascade)
  title          String
  description    String
  severity       RiskSeverity
  likelihood     RiskSeverity
  status         RiskStatus   @default(OPEN)
  mitigationPlan String?
  ownerId        String?
  owner          User?        @relation("RiskOwner", fields: [ownerId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Set when this Risk was auto-opened by a "No" answer to a Control's
  // Self-Assessment Question, rather than logged ad-hoc. Null for ad-hoc Risks.
  controlAssessmentId String?
  controlAssessment   ControlAssessment? @relation(fields: [controlAssessmentId], references: [id])
}

// Formal sign-off record on a System's onboarding.
model Approval {
  id         String           @id @default(cuid())
  systemId   String
  system     System           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  approverId String
  approver   User             @relation(fields: [approverId], references: [id])
  decision   OnboardingStatus
  comment    String?
  decidedAt  DateTime         @default(now())
}

enum ChangeEventAction {
  SYSTEM_SUBMITTED
  APPROVAL_DECIDED
  SYSTEM_ONBOARDED
  RISK_STATUS_CHANGED
  ASSESSMENT_STATUS_CHANGED
  QUERY_OPENED
  QUERY_REPLIED
  QUERY_RESOLVED
  CLASSIFICATION_CHANGED
  // System-less: evidence-bearing changes to the requirement database
  // (PRD 0001 F-CE.1). Schema only for now; emitted by the authoring
  // issue (#73).
  CONTROL_MAPPING_CHANGED
  FRAMEWORK_PUBLISHED
  // "system"-actor: the requirement database changed under a System (a Framework was
  // published, a Control Mapping or a Control's scoping changed) and its applicable
  // Controls moved (PRD 0001 F-AP.3, #87). Kept apart from CLASSIFICATION_CHANGED,
  // which is the owner changing the System's own classification.
  APPLICABILITY_RECOMPUTED
  // The System's owner or an Admin removed a stale Control Assessment (#109). The row is
  // deleted, so its last status, evidence and notes are kept only in this event's detail.
  ASSESSMENT_REMOVED
}

// A curated, System-lifecycle-relevant mutation record — feeds the landing
// page's "Recent updates" feed (see #58). Usually System-scoped; the
// System-less actions (systemId null) record evidence-bearing changes to the
// requirement database (PRD 0001 F-CE.1). Deliberately not a full audit
// trail: pure catalog-admin CRUD (Control/DeploymentFacet/Capability/
// BusinessUnit/Framework create/edit/delete) is out of
// scope, since this exists for role-relevant "what changed on this System"
// visibility, not compliance auditing. `actorId` is either a User id, or the
// literal string "system" for a transition the backend computed as a side
// effect of a different, human-initiated action (e.g. Capability
// auto-fulfillment, or a Risk auto-opened by a "No" Self-Assessment answer)
// rather than a direct edit to that specific row — deliberately not a User
// relation, since "system" never matches a real User id.
model ChangeEvent {
  id        String            @id @default(cuid())
  // Null for System-less events (CONTROL_MAPPING_CHANGED, FRAMEWORK_PUBLISHED).
  systemId  String?
  system    System?           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  action    ChangeEventAction
  detail    String
  actorId   String
  createdAt DateTime          @default(now())

  @@index([systemId, createdAt])
  @@index([createdAt])
}
