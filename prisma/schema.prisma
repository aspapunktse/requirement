generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

enum RequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
  NOT_APPLICABLE
  WAIVED
}

// The System Owner's answer to a Requirement's Self-Assessment Question —
// recorded alongside RequirementStatus, not a replacement for it. Yes/No/NA
// map to Fulfilled/left-open-plus-Risk/Not Applicable respectively.
enum SelfAssessmentAnswer {
  YES
  NO
  NA
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// One shared ordinal scale reused across Confidentiality, Integrity, and
// Availability — simpler to build/administer than three independent scales,
// and this app has no existing BIA/FIPS-199-style framework to match
// instead. See ADR 0003.
enum ImpactLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  TRANSFERRED
  CLOSED
}

enum UserRole {
  ADMIN
  RISK_OWNER
  SYSTEM_OWNER
  REVIEWER
  VIEWER
  // Scoped to specific Business Unit(s) and/or Framework(s) it's assigned
  // to, rather than RISK_OWNER's full cross-System visibility. Sees Risks
  // and compliance percentage for Systems within its assigned scope only,
  // read/reporting-only — does not manage Risk status. A separate role from
  // RISK_OWNER, not a replacement for it. See #55.
  BUSINESS_RISK_OWNER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())

  ownedSystems       System[]                @relation("SystemOwner")
  assessments        RequirementAssessment[] @relation("AssessedBy")
  riskActions        Risk[]                  @relation("RiskOwner")
  approvals          Approval[]
  // Business Units and Frameworks this User (as a BUSINESS_RISK_OWNER) is
  // assigned to. Independent of each other — a Business Risk Owner may own
  // Business Units, Frameworks, or both, not necessarily paired. See #55.
  businessUnitScopes BusinessUnit[]
  frameworkScopes    Framework[]             @relation("FrameworkRiskOwner")
  resolvedQueries    RequirementQuery[]      @relation("QueryResolvedBy")
  queryMessages      QueryMessage[]
}

// A system or cloud solution being onboarded into the enterprise.
model System {
  id                         String              @id @default(cuid())
  name                       String
  vendor                     String?
  description                String?
  status                     OnboardingStatus    @default(DRAFT)
  // Self-declared Impact Level on each CIA axis, independently — null means
  // "not yet classified" on that axis, distinct from LOW. Replaces the old
  // unenforced free-text dataClassification field. See ADR 0003.
  confidentialityImpactLevel ImpactLevel?
  integrityImpactLevel       ImpactLevel?
  availabilityImpactLevel    ImpactLevel?
  ownerId                    String
  owner                      User                @relation("SystemOwner", fields: [ownerId], references: [id])
  // One or more deployment facets this System spans (e.g. On-Prem, Cloud) —
  // a Hybrid System is simply one that declares more than one. See ADR 0003.
  deploymentFacets           DeploymentFacet[]
  // Regulatory Overlays this System Owner self-declares apply (e.g. GDPR,
  // EAR/ITAR) — same self-declaration model as Capability. See ADR 0003.
  regulatoryOverlays         RegulatoryOverlay[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  // When the System was actually marked Onboarded — distinct from Approval
  // (a judgment call) and from updatedAt (touched by unrelated edits). See
  // ADR 0001.
  onboardedAt                DateTime?

  assessments     RequirementAssessment[]
  risks           Risk[]
  approvals       Approval[]
  // Centrally-managed dependencies this System declares it consumes. Purely
  // declarative in this ticket — auto-fulfilling mapped Requirements is #16.
  capabilities    Capability[]
  // Business Units that consume this System, and the Framework(s) whose
  // audit/certification boundary it falls within. Both are purely
  // reporting/grouping dimensions — unlike deploymentFacets/
  // regulatoryOverlays/Impact Level/capabilities, declaring either has no
  // effect on the applicable Requirement set, and neither is Draft-locked:
  // usage and audit scope can both change after a System is Onboarded. See
  // #55.
  businessUnits   BusinessUnit[]
  frameworkScopes Framework[]             @relation("SystemFrameworkScope")
  // Curated log of System-lifecycle-relevant mutations, feeding the landing
  // page's "Recent updates" feed. See #58.
  changeEvents    ChangeEvent[]
}

// An admin-curated deployment classification (e.g. On-Premises Datacenter,
// Cloud IaaS/PaaS, SaaS) that determines which Requirements apply to a
// System. A System declares one or more facets — Hybrid is simply a System
// with more than one declared, not its own catalog entry. See ADR 0003
// (which supersedes ADR 0002's single-select-only design).
model DeploymentFacet {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Requirements scoped to this facet. A Requirement with no rows here at
  // all applies regardless of facet (see Requirement.deploymentFacets).
  requirements Requirement[]
  systems      System[]
}

// An admin-curated, centrally-provided dependency (e.g. Active Directory,
// a central IAM/SSO platform, a central KMS) a System can declare it
// consumes. Standalone catalog concept — not a reference to any actual
// onboarded System, even if the same real-world thing is also tracked
// as a System elsewhere.
model Capability {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Requirements this Capability auto-fulfills when a System declares it.
  requirements             Requirement[]
  // Systems that have declared this Capability as consumed.
  systems                  System[]
  // RequirementAssessments currently auto-fulfilled by this Capability.
  autoFulfilledAssessments RequirementAssessment[]
}

// An admin-curated regulatory flag (e.g. GDPR, EAR/ITAR) a System Owner
// self-declares applies to their System at onboarding — same self-
// declaration model as Capability, not derived from any other structured
// field. See ADR 0003.
model RegulatoryOverlay {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Requirements scoped to this overlay. A Requirement with no rows here at
  // all applies regardless of overlay (see Requirement.regulatoryOverlays).
  requirements Requirement[]
  systems      System[]
}

// An admin-curated organizational consumer (e.g. Finance, HR) that a System
// declares is using it. Purely a reporting/grouping dimension — has no
// effect on a System's applicable Requirement set. Not Draft-locked: a
// Business Unit can start or stop consuming an already-Onboarded System.
// See #55.
model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Systems this Business Unit consumes/uses.
  systems    System[]
  // Users assigned this Business Unit as (part of) their
  // BUSINESS_RISK_OWNER portfolio.
  riskOwners User[]
}

// An admin-curated compliance standard (e.g. ISO 27001:2022 Annex A, CMMC)
// that composes two independent relations: which Requirements satisfy it
// (tagging — one Requirement can satisfy more than one Framework at once,
// same "author once, tag many" model as before), and which Systems fall
// within its audit/certification boundary (a System's Framework Scope,
// multi-select and independent per Framework — a System can be in ISO
// scope without being in CMMC scope). Declaring a System's Framework Scope
// is a reporting dimension only, like Business Unit, and not Draft-locked.
// Promoted from a bare `Requirement.framework: String[]` free-text tag to
// support strictComplianceRequired and the System-side relation — see #55
// and its ADR.
model Framework {
  id                       String   @id @default(cuid())
  name                     String   @unique
  description              String?
  // Some frameworks only accept 100% Fulfilled when computing compliance
  // percentage against them — no partial credit for Waived/Not Applicable.
  strictComplianceRequired Boolean  @default(false)
  createdAt                DateTime @default(now())

  // Requirements tagged as satisfying this Framework.
  requirements  Requirement[]
  // Systems whose audit/certification boundary includes this Framework.
  scopedSystems System[]      @relation("SystemFrameworkScope")
  // Users assigned this Framework as (part of) their BUSINESS_RISK_OWNER
  // portfolio.
  riskOwners    User[]        @relation("FrameworkRiskOwner")
}

enum RequirementApplicability {
  ORGANIZATIONAL
  PER_SYSTEM
  BOTH
}

// A reusable requirement definition (security, legal, compliance, operational, etc.)
model Requirement {
  id            String                   @id @default(cuid())
  code          String                   @unique // e.g. SEC-001
  title         String
  description   String
  category      String // e.g. Security, Privacy, Legal, Operational
  mandatory     Boolean                  @default(true)
  applicability RequirementApplicability
  question      String? // self-assessment question; null for ORGANIZATIONAL-only requirements
  intent        String? // why the question matters, shown alongside it
  examples      String[] // example ways to satisfy the requirement
  createdAt     DateTime                 @default(now())

  assessments RequirementAssessment[]

  // Deployment Facets this Requirement is scoped to. Empty means "applies
  // regardless of facet" (how the Annex A seed ships). Must stay empty for
  // ORGANIZATIONAL requirements, which are never assessed per System.
  deploymentFacets              DeploymentFacet[]
  // Regulatory Overlays this Requirement is scoped to. Empty means "applies
  // regardless of overlay." AND'd together with deploymentFacets scoping —
  // both independently optional, and both must pass. Must stay empty for
  // ORGANIZATIONAL requirements, which are never assessed per System.
  regulatoryOverlays            RegulatoryOverlay[]
  // Minimum required Impact Level on each CIA axis, independently — null
  // means no threshold on that axis. A Requirement can combine thresholds
  // on one, two, or all three axes; each is a "System's level on this axis
  // must be >= this" comparison, not a membership check like facet/overlay
  // scoping. See ADR 0003.
  minConfidentialityImpactLevel ImpactLevel?
  minIntegrityImpactLevel       ImpactLevel?
  minAvailabilityImpactLevel    ImpactLevel?
  // Capabilities that, if a System declares one, auto-fulfill this
  // Requirement. May be empty, one, or several (any one suffices).
  capabilities                  Capability[]
  // Every Framework/standard this Requirement satisfies (e.g. ISO 27001:2022
  // Annex A, CSA CCM 4.0). A relation, not a single value: one Requirement
  // row can be conceptually "the same control" across more than one
  // Framework at once (see #52). Empty means no Framework tagged yet, not
  // "applies to all Frameworks." Was a free-text String[] tag before #55;
  // promoted to a real catalog entity — see Framework and its ADR.
  frameworks                    Framework[]
}

// Fulfillment status of a Requirement for a specific System.
model RequirementAssessment {
  id                      String                @id @default(cuid())
  systemId                String
  system                  System                @relation(fields: [systemId], references: [id], onDelete: Cascade)
  requirementId           String
  requirement             Requirement           @relation(fields: [requirementId], references: [id])
  status                  RequirementStatus     @default(NOT_STARTED)
  evidence                String? // link or note to supporting evidence
  notes                   String?
  // The System Owner's Yes/No/N/A answer to the Requirement's Self-
  // Assessment Question, if it's been answered. Distinct from `status`:
  // both are shown, and manual status edits don't touch this field.
  selfAssessmentAnswer    SelfAssessmentAnswer?
  assessedById            String?
  assessedBy              User?                 @relation("AssessedBy", fields: [assessedById], references: [id])
  assessedAt              DateTime?
  updatedAt               DateTime              @updatedAt
  // Set when this Assessment was auto-fulfilled by a declared Capability
  // (see #16) rather than by a human. Non-null means "eligible for
  // automatic reversion if that Capability is un-declared" — any manual
  // edit to this Assessment clears it, which is what makes the row immune
  // to future automatic reversion and marks it as human-owned going forward.
  fulfilledByCapabilityId String?
  fulfilledByCapability   Capability?           @relation(fields: [fulfilledByCapabilityId], references: [id])

  // Risks auto-opened by answering "No" to this Requirement's Self-
  // Assessment Question.
  originatedRisks Risk[]
  // Requirement Queries raised against this Assessment specifically (see
  // #56) — a lightweight, non-blocking question/reply thread, distinct from
  // both the Self-Assessment Question above and Approval.comment.
  queries RequirementQuery[]

  @@unique([systemId, requirementId])
}

// A lightweight, non-blocking question/reply thread scoped to one specific
// RequirementAssessment (see #56) — lets a REVIEWER/RISK_OWNER/ADMIN push
// back on one Requirement without a whole-System Rejection. Purely
// informational: it never touches the Assessment's status, gates Approval,
// or affects the mandatory-Requirement submission check. `resolved` is an
// explicit judgment call by a REVIEWER/RISK_OWNER/ADMIN (not the System
// Owner, and not necessarily the original asker) — see `lastMessageAuthorId`
// below for the "whose turn is it" logic the various open-Query counters use.
model RequirementQuery {
  id                      String    @id @default(cuid())
  requirementAssessmentId String
  requirementAssessment   RequirementAssessment @relation(fields: [requirementAssessmentId], references: [id], onDelete: Cascade)
  resolved                Boolean   @default(false)
  resolvedById            String?
  resolvedBy              User?     @relation("QueryResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt              DateTime?
  createdAt               DateTime  @default(now())
  // Denormalized copy of the most recent QueryMessage's authorId, kept in
  // sync on every new message. Lets "is it the System Owner's turn, or the
  // reviewer side's?" be answered with a plain field comparison instead of a
  // subquery against QueryMessage every time a counter is computed.
  lastMessageAuthorId String

  messages QueryMessage[]
}

// One turn within a RequirementQuery thread — either the question that
// opened it or a later reply. No separate subject/title on the thread
// itself; it's identified by the Requirement it's attached to plus this
// message's own text.
model QueryMessage {
  id                 String           @id @default(cuid())
  requirementQueryId String
  requirementQuery   RequirementQuery @relation(fields: [requirementQueryId], references: [id], onDelete: Cascade)
  authorId           String
  author             User             @relation(fields: [authorId], references: [id])
  body               String
  createdAt          DateTime         @default(now())
}

// A risk identified during onboarding of a System.
model Risk {
  id             String       @id @default(cuid())
  systemId       String
  system         System       @relation(fields: [systemId], references: [id], onDelete: Cascade)
  title          String
  description    String
  severity       RiskSeverity
  likelihood     RiskSeverity
  status         RiskStatus   @default(OPEN)
  mitigationPlan String?
  ownerId        String?
  owner          User?        @relation("RiskOwner", fields: [ownerId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Set when this Risk was auto-opened by a "No" answer to a Requirement's
  // Self-Assessment Question, rather than logged ad-hoc. Null for ad-hoc Risks.
  requirementAssessmentId String?
  requirementAssessment   RequirementAssessment? @relation(fields: [requirementAssessmentId], references: [id])
}

// Formal sign-off record on a System's onboarding.
model Approval {
  id         String           @id @default(cuid())
  systemId   String
  system     System           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  approverId String
  approver   User             @relation(fields: [approverId], references: [id])
  decision   OnboardingStatus
  comment    String?
  decidedAt  DateTime         @default(now())
}

enum ChangeEventAction {
  SYSTEM_SUBMITTED
  APPROVAL_DECIDED
  SYSTEM_ONBOARDED
  RISK_STATUS_CHANGED
  ASSESSMENT_STATUS_CHANGED
  QUERY_OPENED
  QUERY_REPLIED
  QUERY_RESOLVED
  CLASSIFICATION_CHANGED
}

// A curated, System-lifecycle-relevant mutation record — feeds the landing
// page's "Recent updates" feed (see #58). Deliberately not a full audit
// trail: pure catalog-admin CRUD (Requirement/DeploymentFacet/Capability/
// RegulatoryOverlay/BusinessUnit/Framework create/edit/delete) is out of
// scope, since this exists for role-relevant "what changed on this System"
// visibility, not compliance auditing. `actorId` is either a User id, or the
// literal string "system" for a transition the backend computed as a side
// effect of a different, human-initiated action (e.g. Capability
// auto-fulfillment, or a Risk auto-opened by a "No" Self-Assessment answer)
// rather than a direct edit to that specific row — deliberately not a User
// relation, since "system" never matches a real User id.
model ChangeEvent {
  id        String            @id @default(cuid())
  systemId  String
  system    System            @relation(fields: [systemId], references: [id], onDelete: Cascade)
  action    ChangeEventAction
  detail    String
  actorId   String
  createdAt DateTime          @default(now())

  @@index([systemId, createdAt])
  @@index([createdAt])
}
