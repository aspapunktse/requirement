generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

enum ControlAssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
  NOT_APPLICABLE
  WAIVED
}

// The System Owner's answer to a Control's Self-Assessment Question —
// recorded alongside ControlAssessmentStatus, not a replacement for it. Yes/No/NA
// map to Fulfilled/left-open-plus-Risk/Not Applicable respectively.
enum SelfAssessmentAnswer {
  YES
  NO
  NA
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// One shared ordinal scale reused across Integrity and Availability —
// simpler to build/administer than independent scales, and this app has no
// existing BIA/FIPS-199-style framework to match instead. See ADR 0003.
// Confidentiality is not on this scale: the Sensitivity Level replaces it
// (ADR 0011).
enum ImpactLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  TRANSFERRED
  CLOSED
}

enum UserRole {
  ADMIN
  RISK_OWNER
  SYSTEM_OWNER
  REVIEWER
  VIEWER
  // Scoped to specific Business Unit(s) and/or Framework(s) it's assigned
  // to, rather than RISK_OWNER's full cross-System visibility. Sees Risks
  // and compliance percentage for Systems within its assigned scope only,
  // read/reporting-only — does not manage Risk status. A separate role from
  // RISK_OWNER, not a replacement for it. See #55.
  BUSINESS_RISK_OWNER
  // Curates the requirement database: the Control Library and the Framework
  // catalog (Admin stays a superuser over both). Reads every System, but
  // never changes a System, its Assessments, Risks, or Assessment Queries.
  // Separate from ADMIN, who keeps users, roles, and the remaining catalogs.
  // See #71 and PRD 0001 §5.
  COMPLIANCE_MANAGER
  // Independent of what it audits (ISO 27001 clause 9.2): reads every System,
  // Control, Framework, Assessment, Risk and Organization Control
  // Implementation, and writes nothing outside its own Internal Audits and
  // Check-ups (which come later). Strictly read-only elsewhere, even as the
  // recorded owner of a System or Control. See #147 and PRD 0001 §5.
  INTERNAL_AUDITOR
  // Facilitates the Risk Analysis meeting (#362, product-owner decision of 2026-11-11 on #360): records,
  // edits and completes a Risk Analysis (never on a System it owns), raises Risks in it and assigns Risk
  // owners, here and on an opened System Risk. Reads every System and the Risk register. Nothing else:
  // no Risk status changes, no ad hoc Risk logging, no waiving, no Organization Risks, no creating Systems.
  RISK_FACILITATOR
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  gateDecisions        GateDecision[] @relation("GateDecisionDecider")
  changeReviewsDecided ChangeReview[] @relation("ChangeReviewDecider")
  role                 UserRole       @default(VIEWER)
  createdAt            DateTime       @default(now())

  statSnapshots                      StatSnapshot[]
  appSettingsChanged                 AppSetting[]                        @relation("AppSettingUpdatedBy")
  ownedSystems                       System[]                            @relation("SystemOwner")
  // Systems this User is the Business System Owner of (#321). Deleting the User leaves them without one.
  businessOwnedSystems               System[]                            @relation("SystemBusinessOwner")
  assessments                        ControlAssessment[]                 @relation("AssessedBy")
  riskActions                        Risk[]                              @relation("RiskOwner")
  approvals                          Approval[]
  // OG1 verdicts this User gave (#328).
  trackVerdicts                      TrackVerdict[]
  // OAG review Recommendations this User gave (#331).
  recommendations                    Recommendation[]
  // Business Units and Frameworks this User (as a BUSINESS_RISK_OWNER) is
  // assigned to. Independent of each other — a Business Risk Owner may own
  // Business Units, Frameworks, or both, not necessarily paired. See #55.
  businessUnitScopes                 BusinessUnit[]
  frameworkScopes                    Framework[]                         @relation("FrameworkRiskOwner")
  // Review Groups this User is a member of (#197). Membership is independent of role, except
  // that an Internal Auditor can't be a member (enforced in the API, not the schema).
  reviewGroups                       ReviewGroup[]                       @relation("ReviewGroupMember")
  resolvedQueries                    AssessmentQuery[]                   @relation("QueryResolvedBy")
  queryMessages                      QueryMessage[]
  acceptedGaps                       Requirement[]                       @relation("GapAcceptedBy")
  ownedControls                      Control[]                           @relation("ControlOwner")
  // Frameworks this User owns (the Framework Owner, #319). Deleting the User leaves them without an owner.
  ownedFrameworks                    Framework[]                         @relation("FrameworkOwner")
  internalAuditsCreated              InternalAudit[]                     @relation("InternalAuditCreator")
  internalAuditsLaunched             InternalAudit[]                     @relation("InternalAuditLauncher")
  internalAuditsClosed               InternalAudit[]                     @relation("InternalAuditCloser")
  checkUpResponsesGiven              CheckUpResponse[]                   @relation("CheckUpResponder")
  checkUpResponsesChanged            CheckUpResponse[]                   @relation("CheckUpResponseChanger")
  checkUpsEvaluated                  CheckUpEvaluation[]                 @relation("CheckUpEvaluator")
  checkUpsWithdrawn                  CheckUpWithdrawal[]                 @relation("CheckUpWithdrawer")
  organizationImplementationsUpdated OrganizationControlImplementation[] @relation("OrganizationImplementationUpdatedBy")
  systemDocumentsUpdated             SystemDocument[]                    @relation("SystemDocumentUpdatedBy")
  systemDocumentFilesUploaded        SystemDocumentFile[]                @relation("SystemDocumentFileUploadedBy")
  riskAnalysesRecorded               RiskAnalysis[]                      @relation("RiskAnalysisRecordedBy")
  riskAnalysesCompleted              RiskAnalysis[]                      @relation("RiskAnalysisCompletedBy")
  riskAnalysesAttended               RiskAnalysis[]                      @relation("RiskAnalysisParticipants")
}

// One of the five fixed, ordered Sensitivity Levels (ADR 0011): 1 Public,
// 2 Internal, 3 Sensitive, 4 Highly Sensitive, 5 Critical Sensitivity. The
// ordinal is the key and what Controls compare by. Label, description and colours
// are display text. The rows are inserted by a migration (not the seed), so
// every database has them. A CHECK constraint keeps `level` within 1-5.
model SensitivityLevel {
  level            Int               @id
  label            String
  description      String
  textColor        String
  backgroundColor  String
  systems          System[]          @relation("SystemSensitivityLevel")
  controls         Control[]         @relation("ControlMinSensitivityLevel")
  informationTypes InformationType[] @relation("InformationTypeSensitivityLevel")
}

// A kind of information the enterprise handles (e.g. Customer personal data, Payroll), kept in a catalogue the
// Compliance Manager or an Admin curates, each with one Sensitivity Level (ADR 0012). A System declares any
// number of them (declaring is a later issue); the highest level among them is the floor for the System's own.
// Raising a type's level never changes a System. It also suggests Frameworks (ADR 0013, #300): a System that
// declares the type is offered each Published, non-base one for its Framework Scope, which its owner confirms or
// leaves out; nothing enters a Framework Scope by itself.
model InformationType {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?
  sensitivityLevel Int
  sensitivity      SensitivityLevel @relation("InformationTypeSensitivityLevel", fields: [sensitivityLevel], references: [level], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Systems that declare this type.
  systems System[]

  // The Frameworks this type suggests (ADR 0013). Implicit many-to-many `_InformationTypeSuggestedFramework`:
  // A = Framework id, B = InformationType id (alphabetical model order). A Draft Framework may be linked; it only
  // suggests once Published. The base Framework is refused by the API (it is always in scope).
  suggestedFrameworks         Framework[]                  @relation("InformationTypeSuggestedFramework")
  // The owners' decisions to leave one of those out, per System.
  frameworkSuggestionDeclines FrameworkSuggestionDecline[]
}

// An owner's decision to leave out a Framework that an Information Type suggests, for one System (ADR 0013).
// One row per (System, Information Type, Framework). While the System still declares the type, the suggestion
// is not open and the System is not flagged for it. A row goes with the System, the type or the Framework.
model FrameworkSuggestionDecline {
  systemId          String
  system            System          @relation(fields: [systemId], references: [id], onDelete: Cascade)
  informationTypeId String
  informationType   InformationType @relation(fields: [informationTypeId], references: [id], onDelete: Cascade)
  frameworkId       String
  framework         Framework       @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@id([systemId, informationTypeId, frameworkId])
  @@index([informationTypeId])
  @@index([frameworkId])
}

// Where a System's data is stored (#357).
enum DataLocation {
  SWEDEN
  EU_EEA
  OUTSIDE_EU_EEA
  UNKNOWN
}

// The state of the Data Processing Agreement with a System's vendor (#357).
enum DataProcessingAgreementStatus {
  SIGNED
  IN_PROGRESS
  NOT_SIGNED
  NOT_NEEDED
}

// A system or cloud solution being onboarded into the enterprise.
model System {
  id                          String                         @id @default(cuid())
  name                        String
  vendor                      String?
  description                 String?
  // About the system (#357): where to find the vendor and the service, where the data lives and the
  // contract. All optional here; vendor and service URL are required for a System that declares a
  // Deployment Facet with requiresVendorDetails (enforced by the create and details routes).
  vendorWebsiteUrl            String?
  serviceUrl                  String?
  productPlan                 String?
  vendorTrustUrl              String?
  dataLocation                DataLocation?
  dataProcessingAgreement     DataProcessingAgreementStatus?
  contractReference           String?
  contractRenewalDate         DateTime?                      @db.Date
  // Whole months before the renewal date that the contract must be cancelled (0-120).
  noticePeriodMonths          Int?
  status                      OnboardingStatus               @default(DRAFT)
  // Self-declared Impact Level on the Integrity and Availability axes,
  // independently — null means "not yet classified" on that axis, distinct
  // from LOW. See ADR 0003.
  integrityImpactLevel        ImpactLevel?
  availabilityImpactLevel     ImpactLevel?
  // The Sensitivity Level (1-5, a SensitivityLevel row) of the information the
  // System handles; null until the owner sets it. Replaces the Confidentiality
  // Impact Level (ADR 0011). A Control's minimum is compared by this number.
  sensitivityLevel            Int?
  sensitivity                 SensitivityLevel?              @relation("SystemSensitivityLevel", fields: [sensitivityLevel], references: [level], onDelete: Restrict)
  ownerId                     String
  owner                       User                           @relation("SystemOwner", fields: [ownerId], references: [id])
  // The Business System Owner (PRD 0002 F-BSO, ADR 0014, #321): the person who will decide the System's evaluation gates.
  // Optional for now; any User, whatever their role, but never the System's owner. Deleting the User leaves the System without one.
  businessSystemOwnerId       String?
  businessSystemOwner         User?                          @relation("SystemBusinessOwner", fields: [businessSystemOwnerId], references: [id], onDelete: SetNull)
  documents                   SystemDocument[]
  riskAnalyses                RiskAnalysis[]
  // Staged evaluation (PRD 0002, ADR 0014, #328). A System created while the App Setting "Staged evaluation for new
  // Systems" is on starts at the first round; null is the classic flow (Draft, In Review, Approved, Onboarded), which
  // is what every System created before, or while the setting is off, has. A staged System keeps its Onboarding Status
  // (Draft) until a later issue moves it. The Track is not chosen until OG1 closes. `evaluationStageEnteredAt` is when
  // it entered the current stage: a Risk Analysis completed since then, and the verdicts given since then, are the ones that count.
  evaluationStage             EvaluationStage?
  evaluationTrack             EvaluationTrack?
  evaluationStageEnteredAt    DateTime?
  trackVerdicts               TrackVerdict[]
  recommendations             Recommendation[]
  // Set when the Business System Owner rejects the System at OG3 (#330): the evaluation is closed for good, and every write on the
  // System is refused (409). The Onboarding Status is REJECTED too, but a classic Rejected System returns to Draft; this marker is what
  // tells the two apart. Null for every other System.
  evaluationClosedAt          DateTime?
  gateDecisions               GateDecision[]
  changeReviews               ChangeReview[]
  // One or more deployment facets this System spans (e.g. On-Prem, Cloud) —
  // a Hybrid System is simply one that declares more than one. See ADR 0003.
  deploymentFacets            DeploymentFacet[]
  // The Information Types the System declares (ADR 0012).
  informationTypes            InformationType[]
  // Suggested Frameworks the owner left out (ADR 0013).
  frameworkSuggestionDeclines FrameworkSuggestionDecline[]
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  // When the System was actually marked Onboarded — distinct from Approval
  // (a judgment call) and from updatedAt (touched by unrelated edits). See
  // ADR 0001.
  onboardedAt                 DateTime?

  assessments          ControlAssessment[]
  risks                Risk[]
  approvals            Approval[]
  reviewRounds         ReviewRound[]
  // Business Units that consume this System (a reporting/grouping dimension
  // only), and the Framework(s) this System declares in scope. The declared
  // Framework Scope drives which Controls apply (the base Framework is
  // always in scope on top of it); see ADR 0007, which retired Regulatory
  // Overlay in its favour. Neither is Draft-locked. See #55.
  businessUnits        BusinessUnit[]
  frameworkScopes      Framework[]           @relation("SystemFrameworkScope")
  // A Provider is a System other Systems depend on and inherit Controls from
  // (ADR 0008, PRD 0001 F-IN.2, #123). The System's owner or an Admin marks
  // or unmarks it; unmarking is refused while it has Offerings or any System
  // depends on it (#124).
  isProvider           Boolean               @default(false)
  // The Controls this Provider publishes for the Systems depending on it.
  offerings            ControlOffering[]
  // The Providers this System declares it depends on, and the Systems that
  // depend on this one (as a Provider). See ProviderDependency (#124).
  providerDependencies ProviderDependency[]  @relation("DependentSystem")
  internalAudits       InternalAuditSystem[]
  // Check-ups that target this System (#154). Restrict: a System with Check-ups can't be deleted.
  checkUps             CheckUp[]
  dependents           ProviderDependency[]  @relation("ProviderSystem")
  // Curated log of System-lifecycle-relevant mutations, feeding the landing
  // page's "Recent updates" feed. See #58.
  changeEvents         ChangeEvent[]

  @@index([businessSystemOwnerId])
}

// An admin-curated deployment classification (e.g. On-Premises Datacenter,
// Cloud IaaS/PaaS, SaaS) that determines which Controls apply to a
// System. A System declares one or more facets — Hybrid is simply a System
// with more than one declared, not its own catalog entry. See ADR 0003
// (which supersedes ADR 0002's single-select-only design).
model DeploymentFacet {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String?
  // A System declaring this facet must give its vendor name and service URL (#357). An Admin turns it
  // on or off in the catalog; the migration sets it on the facet named SaaS.
  requiresVendorDetails Boolean  @default(false)
  createdAt             DateTime @default(now())

  // Controls scoped to this facet. A Control with no rows here at
  // all applies regardless of facet (see Control.deploymentFacets).
  controls Control[]
  systems  System[]
}

// An admin-curated organizational consumer (e.g. Finance, HR) that a System
// declares is using it. Purely a reporting/grouping dimension — has no
// effect on a System's applicable Control set. Not Draft-locked: a
// Business Unit can start or stop consuming an already-Onboarded System.
// See #55.
model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Systems this Business Unit consumes/uses.
  systems    System[]
  // Users assigned this Business Unit as (part of) their
  // BUSINESS_RISK_OWNER portfolio.
  riskOwners User[]
}

// A named set of Users who review Systems on behalf of the Frameworks the group is tied to
// (see CONTEXT.md, Review Group; ADR 0010). Membership is maintained by hand for now. Later a
// Review Group is to be linked to one Entra ID group that supplies its members; that link is not
// built and has no column yet. The name and the Framework ties stay the app's own record.
model ReviewGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members              User[]                @relation("ReviewGroupMember")
  frameworks           Framework[]
  approvals            Approval[]
  // OG1 verdicts given for this group (#328). Restrict, as for Approvals.
  trackVerdicts        TrackVerdict[]
  // OAG review Recommendations given for this group (#331). Restrict, as for verdicts.
  recommendations      Recommendation[]
  // The Controls added to this group's remit by a Change Review (#334). Restrict, as for Recommendations.
  changeReviewControls ChangeReviewControl[]
  // Query Messages posted, and Assessment Queries resolved, as this group (#201). SetNull on delete: the
  // row keeps the group's name in its own snapshot column and never turns into a base-step or named one.
  queryMessages        QueryMessage[]        @relation("QueryMessageGroup")
  resolvedQueries      AssessmentQuery[]     @relation("QueryResolvedByGroup")
}

// A curated compliance standard, law or regulation (e.g. ISO/IEC 27001:2022,
// CMMC), made up of its own Requirements — the standard's line items —
// which Controls satisfy through Control Mappings (ADR 0005). Each version
// of a standard is its own Framework (name + version is unique), optionally
// linked to the one it supersedes. Exactly one Framework is the base
// Framework (ISO/IEC 27001:2022, whose Annex A seeds the base Control
// Library); "exactly one" is enforced in application code (src/lib/
// frameworks.ts), not by a partial unique index, which Prisma can't
// represent without showing up as schema drift. A Draft Framework is
// invisible to Systems until it's Published. Independently of that, a
// System's Framework Scope says which Frameworks fall within its audit/
// certification boundary (multi-select, per Framework), and a Business Risk
// Owner can be assigned Frameworks as part of their portfolio. See #55,
// #72 and PRD 0001 §7 F-FW.
model Framework {
  id                       String             @id @default(cuid())
  name                     String
  // e.g. "2022". Together with `name`, uniquely identifies the Framework.
  version                  String
  description              String?
  // Some frameworks only accept 100% Fulfilled when computing compliance
  // percentage against them — no partial credit for Waived/Not Applicable.
  strictComplianceRequired Boolean            @default(false)
  // For licensed standards the catalog holds only identifiers, titles and
  // an own-words paraphrase; QUOTABLE (e.g. EU law) may hold verbatim text.
  licensing                FrameworkLicensing @default(PARAPHRASE_ONLY)
  // True for exactly one Framework: ISO/IEC 27001:2022. Always in every
  // System's Framework Scope.
  isBase                   Boolean            @default(false)
  status                   FrameworkStatus    @default(DRAFT)
  // The plain-language question the System onboarding interview asks about this
  // Framework (answer Yes: it joins the new System's Framework Scope), with an
  // optional hint. Never set on the base Framework, which is always in scope.
  onboardingQuestion       String?
  onboardingHint           String?
  createdAt                DateTime           @default(now())

  // The earlier version of this standard this Framework replaces, if any.
  supersedesId String?
  supersedes   Framework?  @relation("FrameworkSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Framework[] @relation("FrameworkSupersedes")

  // This Framework's own line items.
  requirements       Requirement[]
  // Supplementary Controls authored because a Requirement of this
  // Framework had no covering base Control.
  originatedControls Control[]                    @relation("ControlOriginFramework")
  // Systems whose audit/certification boundary includes this Framework.
  scopedSystems      System[]                     @relation("SystemFrameworkScope")
  // Users assigned this Framework as (part of) their BUSINESS_RISK_OWNER
  // portfolio.
  riskOwners         User[]                       @relation("FrameworkRiskOwner")
  // Information Types that suggest this Framework, and the owners' decisions to leave it out (ADR 0013).
  suggestedBy        InformationType[]            @relation("InformationTypeSuggestedFramework")
  suggestionDeclines FrameworkSuggestionDecline[]

  // The Framework Owner (#319): the one User who decides which of this Framework's Controls are first round.
  // Any User, whatever their role; null means no owner (every existing Framework starts that way). Assigned by
  // a Compliance Manager or an Admin. Deleting the User leaves the Framework unowned. Curation, not a Change Event.
  ownerId            String?
  owner              User?                        @relation("FrameworkOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // The Controls the owner marked first round for this Framework (default: none).
  firstRoundControls FrameworkFirstRoundControl[]

  // The Review Group that reviews this Framework's non-base Controls on a System; at most one.
  // Restrict: a Review Group can't be deleted while tied (the API checks first and answers 409).
  reviewGroupId String?
  reviewGroup   ReviewGroup? @relation(fields: [reviewGroupId], references: [id], onDelete: Restrict)

  @@unique([name, version])
  @@index([ownerId])
}

// One Control marked first round for one Framework (#319, PRD 0002 F-FO): the Framework Owner (or a Compliance
// Manager or an Admin) decided it is asked in the first Requirement Round whenever the Framework is in a System's
// effective scope. Only for a Control mapped to the Framework; dropped when its last mapping to the Framework goes.
// Stored and shown only: it changes nothing about Assessments, submission or compliance yet.
model FrameworkFirstRoundControl {
  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlId   String
  control     Control   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([frameworkId, controlId])
  @@index([controlId])
}

enum FrameworkLicensing {
  PARAPHRASE_ONLY
  QUOTABLE
}

// Draft: being authored or mapped — invisible to Systems. Published: can be
// in a System's Framework Scope and affects applicability.
enum FrameworkStatus {
  DRAFT
  PUBLISHED
}

// One line item of exactly one Framework — a clause, article or control
// objective as the standard states it (e.g. ISO 27001 A.8.24). Never
// assessed directly: it is satisfied through the Controls mapped to it (see
// ControlMapping), and its status for a System is derived from theirs. See
// ADR 0005.
model Requirement {
  id               String    @id @default(cuid())
  frameworkId      String
  framework        Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  // The standard's own identifier, e.g. "A.8.24" or "Art. 21(2)(h)".
  // Unique within its Framework.
  code             String
  // Grouping label, e.g. "A.8 Technological".
  section          String
  title            String
  // For PARAPHRASE_ONLY Frameworks, an own-words paraphrase — never
  // verbatim text.
  text             String
  // Gap acceptance (PRD 0001 F-CL.5): a Compliance Manager/Admin accepted
  // that this Requirement stays a Coverage Gap, with a justification. All
  // three are set together or all null (the acceptor becomes null if that
  // User is deleted). Only meaningful while the
  // Requirement is a gap; gaining a Full mapping clears them.
  gapAcceptedAt    DateTime?
  gapAcceptedById  String?
  gapAcceptedBy    User?     @relation("GapAcceptedBy", fields: [gapAcceptedById], references: [id], onDelete: SetNull)
  gapJustification String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mappings ControlMapping[]

  @@unique([frameworkId, code])
}

enum ControlCoverage {
  FULL
  PARTIAL
}

// A many-to-many link between one Requirement and one Control, carrying how
// much of the Requirement the Control covers. A Requirement is covered only
// when its mapped Controls together give FULL coverage; one with no
// mappings, or only PARTIAL ones, is a Coverage Gap. See ADR 0005.
model ControlMapping {
  id            String          @id @default(cuid())
  requirementId String
  requirement   Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  controlId     String
  control       Control         @relation(fields: [controlId], references: [id], onDelete: Cascade)
  coverage      ControlCoverage
  rationale     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([requirementId, controlId])
  @@index([controlId])
}

enum ControlApplicability {
  ORGANIZATIONAL
  PER_SYSTEM
  BOTH
}

// A reusable control definition (security, legal, compliance, operational, etc.)
model Control {
  id                        String               @id @default(cuid())
  code                      String               @unique // e.g. SEC-001
  title                     String
  description               String
  category                  String // e.g. Security, Privacy, Legal, Operational
  mandatory                 Boolean              @default(true)
  applicability             ControlApplicability
  question                  String? // self-assessment question; null for ORGANIZATIONAL-only controls
  intent                    String? // why the question matters, shown alongside it
  examples                  String[] // example ways to satisfy the control
  createdAt                 DateTime             @default(now())
  // The exclusion justification the Statement of Applicability shows while the Control is
  // excluded (F-OUT.4, #150). Authored by a Compliance Manager or an Admin; null means none.
  // Kept when the Control becomes included (inclusion is derived, never stored) and shown
  // again if it is excluded again. Each change is a SOA_JUSTIFICATION_CHANGED Change Event.
  soaExclusionJustification String?

  assessments          ControlAssessment[]
  // Where a Change Review added this Control to a group's remit (#334). Cascade: deleting a Control never blocks on it.
  changeReviewControls ChangeReviewControl[]
  internalAudits       InternalAuditControl[]
  // Check-ups generated for this Control (#154). Restrict: a Control with Check-ups can't be deleted.
  checkUps             CheckUp[]

  // Deployment Facets this Control is scoped to. Empty means "applies
  // regardless of facet" (how the Annex A seed ships). Must stay empty for
  // ORGANIZATIONAL controls, which are never assessed per System.
  deploymentFacets           DeploymentFacet[]
  // Minimum required Impact Level on the Integrity and Availability axes,
  // independently — null means no threshold on that axis. Each is a "System's
  // level on this axis must be >= this" comparison, not a membership check
  // like facet scoping. See ADR 0003.
  minIntegrityImpactLevel    ImpactLevel?
  minAvailabilityImpactLevel ImpactLevel?
  // Minimum Sensitivity Level (1-5): the Control applies only to a System whose
  // level is at or above it; null means no threshold, and a System with no
  // level never meets one (ADR 0011).
  minSensitivityLevel        Int?
  minSensitivity             SensitivityLevel?                  @relation("ControlMinSensitivityLevel", fields: [minSensitivityLevel], references: [level], onDelete: Restrict)
  // Which Requirements this Control satisfies, and how fully. The only way
  // a Control is tied to a Framework — there is no direct Framework tag
  // (ADR 0005, was `frameworks` before #72).
  mappings                   ControlMapping[]
  // Set: a Supplementary Control, authored because a Requirement of this
  // Framework had no covering base Control. Null: a base Control (seeded
  // 1:1 from ISO 27001:2022 Annex A).
  originFrameworkId          String?
  originFramework            Framework?                         @relation("ControlOriginFramework", fields: [originFrameworkId], references: [id], onDelete: Restrict)
  // The Control Owner: the one User who maintains this Control's Organization
  // Control Implementation (F-CL.3, #119). Any User, whatever their role; null
  // means unassigned (every existing Control starts that way, PRD §9.7).
  // Deleting the User leaves the Control unassigned. Curation, not a Change Event.
  ownerId                    String?
  owner                      User?                              @relation("ControlOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // The Organization's own implementation of this Control (#120). Exists for
  // ORGANIZATIONAL and BOTH Controls, never PER_SYSTEM; a missing row reads as
  // Not Started and the first edit creates it.
  organizationImplementation OrganizationControlImplementation?

  // The Frameworks whose owner marked this Control first round (#319).
  firstRoundFor FrameworkFirstRoundControl[]

  // Offerings by Providers of this Control (#123). Deleting the Control removes them.
  offerings ControlOffering[]

  @@index([ownerId])
}

// The Organization's own status and description of how it implements one
// Control (PRD 0001 F-IN.1, #120), e.g. A.5.1 policies or A.6.1 screening.
// At most one per Control (`controlId` is unique), only for ORGANIZATIONAL and
// BOTH Controls. Edited by the Control Owner, a Compliance Manager or an
// Admin. Changes nothing on any System yet: inheritance is #121. Not a
// Change Event, so `updatedById`/`updatedAt` are the whole record. Deleting
// the User who last edited it leaves the row and drops the attribution.
model OrganizationControlImplementation {
  id          String                  @id @default(cuid())
  controlId   String                  @unique
  control     Control                 @relation(fields: [controlId], references: [id], onDelete: Cascade)
  // Same status set as a Control Assessment. Starts Not Started.
  status      ControlAssessmentStatus @default(NOT_STARTED)
  // How the Organization implements the Control. Required (non-empty) once
  // the status is Waived or Not Applicable (`implementationDescriptionRefusal`).
  description String?
  updatedById String?
  updatedBy   User?                   @relation("OrganizationImplementationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([updatedById])
}

// How a Provider's Control Offering is inherited (ADR 0008, F-IN.2): Full covers
// the Control entirely; Shared still leaves the customer responsibility to the
// depending System (credit for it is #125).
enum ControlOfferingType {
  FULL
  SHARED
}

// A Provider's statement that it implements one Control for the Systems
// depending on it (PRD 0001 F-IN.2, #123). At most one per Provider and
// Control. The Provider can only offer a Control that applies to it, so it has
// a Control Assessment for it, which is the status dependents will read (#124).
// If the Control later stops applying to the Provider the Offering is kept (it
// is never deleted by a recompute) and reported as no longer applying. Shared
// needs a customer-responsibility text (`controlOfferingRefusal`); Full stores
// null. Nothing consumes Offerings yet (#124). Each add, change and removal is
// a CONTROL_OFFERING_CHANGED Change Event on the Provider.
model ControlOffering {
  id                     String              @id @default(cuid())
  providerId             String
  provider               System              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  controlId              String
  control                Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  type                   ControlOfferingType
  // What the depending System must still do itself. Required for Shared, null for Full.
  customerResponsibility String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([providerId, controlId])
  @@index([controlId])
}

// A System's declaration that it depends on a Provider and so inherits the
// Provider's Full Control Offerings live (PRD 0001 F-IN.3, #124). At most one
// per (dependent, Provider); the Provider must be a System marked as a Provider
// and never the dependent itself (both enforced by the route, not the schema).
// Mutual dependencies are allowed: there are no chains, so they are harmless.
// Nothing is copied to the dependent: its effective status is derived live. A
// declaration or removal is a CLASSIFICATION_CHANGED Change Event on the
// dependent, like Framework Scope. Both ends cascade with their System.
model ProviderDependency {
  id          String   @id @default(cuid())
  dependentId String
  dependent   System   @relation("DependentSystem", fields: [dependentId], references: [id], onDelete: Cascade)
  providerId  String
  provider    System   @relation("ProviderSystem", fields: [providerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([dependentId, providerId])
  @@index([providerId])
}

// Fulfillment status of a Control for a specific System.
model ControlAssessment {
  id                   String                  @id @default(cuid())
  systemId             String
  system               System                  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  controlId            String
  control              Control                 @relation(fields: [controlId], references: [id])
  status               ControlAssessmentStatus @default(NOT_STARTED)
  evidence             String? // link or note to supporting evidence
  notes                String?
  // The System Owner's Yes/No/N/A answer to the Control's Self-
  // Assessment Question, if it's been answered. Distinct from `status`:
  // both are shown, and manual status edits don't touch this field.
  selfAssessmentAnswer SelfAssessmentAnswer?
  assessedById         String?
  assessedBy           User?                   @relation("AssessedBy", fields: [assessedById], references: [id])
  assessedAt           DateTime?
  updatedAt            DateTime                @updatedAt
  // Risks auto-opened by answering "No" to this Control's Self-
  // Assessment Question.
  originatedRisks      Risk[]
  // Assessment Queries raised against this Assessment specifically (see
  // #56) — a lightweight, non-blocking question/reply thread, distinct from
  // both the Self-Assessment Question above and Approval.comment.
  queries              AssessmentQuery[]

  @@unique([systemId, controlId])
}

// A lightweight, non-blocking question/reply thread scoped to one specific
// ControlAssessment (see #56) — lets a REVIEWER/RISK_OWNER/ADMIN push
// back on one Control without a whole-System Rejection. Purely
// informational: it never touches the Assessment's status, gates Approval,
// or affects the mandatory-Control submission check. `resolved` is an
// explicit judgment call by a REVIEWER/RISK_OWNER/ADMIN (not the System
// Owner, and not necessarily the original asker) — see `lastMessageAuthorId`
// below for the "whose turn is it" logic the various open-Query counters use.
model AssessmentQuery {
  id                      String            @id @default(cuid())
  controlAssessmentId     String
  controlAssessment       ControlAssessment @relation(fields: [controlAssessmentId], references: [id], onDelete: Cascade)
  resolved                Boolean           @default(false)
  resolvedById            String?
  resolvedBy              User?             @relation("QueryResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt              DateTime?
  // Who the resolution is attributed to (#201), fixed when it is made, like a Query Message's:
  // a Review Group (id and name) or the base Review Step (name only), otherwise both null (shown named).
  // The name is a snapshot, so it survives the group being renamed or deleted.
  resolvedByReviewGroupId String?
  resolvedByReviewGroup   ReviewGroup?      @relation("QueryResolvedByGroup", fields: [resolvedByReviewGroupId], references: [id], onDelete: SetNull)
  resolvedAttributedTo    String?
  createdAt               DateTime          @default(now())
  // Denormalized copy of the most recent QueryMessage's authorId, kept in
  // sync on every new message. Lets "is it the System Owner's turn, or the
  // reviewer side's?" be answered with a plain field comparison instead of a
  // subquery against QueryMessage every time a counter is computed.
  lastMessageAuthorId     String

  messages QueryMessage[]
}

// One turn within an AssessmentQuery thread — either the question that
// opened it or a later reply. No separate subject/title on the thread
// itself; it's identified by the Control it's attached to plus this
// message's own text.
model QueryMessage {
  id                String          @id @default(cuid())
  assessmentQueryId String
  assessmentQuery   AssessmentQuery @relation(fields: [assessmentQueryId], references: [id], onDelete: Cascade)
  authorId          String
  author            User            @relation(fields: [authorId], references: [id])
  body              String
  createdAt         DateTime        @default(now())
  // Who the message is attributed to (#201), fixed when it is posted: a Review Group's member
  // posts as the group, a Reviewer as the base Review Step; both null means the author is shown
  // named. `attributedTo` is a snapshot of the shown name, so the message keeps it when the group is
  // renamed or deleted (then `reviewGroupId` is null and only an Admin, Internal Auditor or
  // Compliance Manager sees the author).
  reviewGroupId     String?
  reviewGroup       ReviewGroup?    @relation("QueryMessageGroup", fields: [reviewGroupId], references: [id], onDelete: SetNull)
  attributedTo      String?
}

// Where a Risk came from (CONTEXT.md "Risk Source"). Other kinds of risk will be added as new values.
enum RiskSource {
  REQUIREMENT_NONCONFORMANCE // opened by a "No" Self-Assessment answer
  AUDIT_FINDING // opened by an Internal Auditor's Nonconformity
  AD_HOC // logged directly
}

// A risk identified during onboarding of a System, or opened by an Internal Audit's Nonconformity
// (#157). A Risk belongs to a System, except one opened by an Organization-level Nonconformity,
// which has no System (`systemId` null) and is linked to the Check-up that opened it. A CHECK
// constraint written by hand in the migration ("Risk_system_or_check_up_check") keeps it that way:
// a Risk has a System or a Check-up, never neither (Prisma's schema language can't express it, and
// `migrate diff` ignores check constraints).
model Risk {
  id             String       @id @default(cuid())
  // Where it came from (#322, PRD 0002 F-RA.1). Always set server-side by whatever creates the Risk,
  // never by the client. The default is the ad hoc case, so a creation path that forgets to say
  // lands as ad hoc rather than failing; every path in `src` sets it explicitly.
  source         RiskSource   @default(AD_HOC)
  systemId       String?
  system         System?      @relation(fields: [systemId], references: [id], onDelete: Cascade)
  title          String
  description    String
  severity       RiskSeverity
  likelihood     RiskSeverity
  status         RiskStatus   @default(OPEN)
  mitigationPlan String?
  ownerId        String?
  owner          User?        @relation("RiskOwner", fields: [ownerId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Set when this Risk was auto-opened by a "No" answer to a Control's
  // Self-Assessment Question, rather than logged ad-hoc. Null for ad-hoc Risks.
  controlAssessmentId String?
  controlAssessment   ControlAssessment? @relation(fields: [controlAssessmentId], references: [id])

  // Set when an Internal Auditor's Nonconformity opened this Risk (#157): the Check-up it came
  // from. At most one Risk per Check-up (an evaluation is final, so a Check-up opens at most one).
  // Restrict: a Check-up is audit evidence and nothing deletes one (its audit, Control and System are
  // all Restrict), so this only says that if a Check-up ever did go, it could not take a Risk with it.
  checkUpId String?  @unique
  checkUp   CheckUp? @relation(fields: [checkUpId], references: [id], onDelete: Restrict)

  // The Risk Analysis meeting this Risk was raised in (#325): set when it is logged from that meeting's form.
  // Kept (set to null) if the analysis is ever deleted; nothing deletes one today.
  raisedInAnalysisId String?
  raisedInAnalysis   RiskAnalysis?  @relation("RiskAnalysisRaised", fields: [raisedInAnalysisId], references: [id], onDelete: SetNull)
  // The Risk Analyses that reviewed this Risk (#325).
  reviewedInAnalyses RiskAnalysis[] @relation("RiskAnalysisReviewed")

  @@index([raisedInAnalysisId])
}

// A Risk Analysis meeting on a System (#325, PRD 0002 F-RA.2-3; CONTEXT.md "Risk Analysis"). Recorded by a Risk Owner or an
// Admin who isn't the System's owner: when it was held, who took part (Users, plus named outsiders such as the vendor as
// free text), notes, the Risks it reviewed and the ones raised in it (`Risk.raisedInAnalysisId`). Editable until completed
// (`completedAt` set), then read-only. Completion needs every open Risk on the System to have an owner. Deleted with the System.
model RiskAnalysis {
  id            String    @id @default(cuid())
  systemId      String
  system        System    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  // The day of the meeting (stored as midnight UTC).
  heldOn        DateTime
  notes         String    @default("")
  participants  User[]    @relation("RiskAnalysisParticipants")
  // Named outsiders (the vendor's people, say), free text.
  outsiders     String[]
  reviewedRisks Risk[]    @relation("RiskAnalysisReviewed")
  raisedRisks   Risk[]    @relation("RiskAnalysisRaised")
  recordedById  String?
  recordedBy    User?     @relation("RiskAnalysisRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("RiskAnalysisCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([systemId, completedAt])
}

// Formal sign-off record on a System's onboarding.
// One submission of a System for review (CONTEXT.md: Review Round, ADR 0010). Every
// Approval belongs to exactly one round; a resubmission starts a new one. The Review
// Steps of a round are NOT stored: they are derived live from the System's Framework
// Scope (src/lib/review-steps.ts). Approvals from before rounds existed each sit in a
// round of their own.
model ReviewRound {
  id          String     @id @default(cuid())
  systemId    String
  system      System     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  submittedAt DateTime   @default(now())
  approvals   Approval[]

  @@index([systemId, submittedAt])
}

model Approval {
  id            String           @id @default(cuid())
  systemId      String
  system        System           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  reviewRoundId String
  reviewRound   ReviewRound      @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  // The Review Step this decision belongs to: null is the base Review Step, otherwise the
  // Review Group whose step it is. Restrict: deleting a group must never silently turn its
  // recorded decisions into base-step ones, nor erase them.
  reviewGroupId String?
  reviewGroup   ReviewGroup?     @relation(fields: [reviewGroupId], references: [id], onDelete: Restrict)
  approverId    String
  approver      User             @relation(fields: [approverId], references: [id])
  decision      OnboardingStatus
  comment       String?
  decidedAt     DateTime         @default(now())
  // Set when the step this decision belongs to disappeared from the round (its group's remit
  // went). A voided decision stays in the history but no longer counts, so the step comes back
  // Open if it returns during the same Review Round (#199).
  voidedAt      DateTime?
  // Why it was voided when an edit reopened the step ("A.5.1 changed after approval", #200).
  // Null for a dropped step's void (#199) and for a live Approval.
  voidReason    String?

  @@index([reviewRoundId])
}

// An OG1 verdict (#328, PRD 0002 F-ST.3): the base review or a Review Group (as part of the Onboarding Advisory Group) judges
// from the first-round answers whether the System takes the Self or the Full track. Like an Approval it is the participant's,
// not the person's: `reviewGroupId` null is the base review. Only verdicts given since the System entered OG1
// (`System.evaluationStageEnteredAt`) count, so a later run of OG1 starts every participant open. A verdict is voided (kept in
// the history) when its participant leaves OG1 or an owner edit in its remit reopens it.
model TrackVerdict {
  id            String          @id @default(cuid())
  systemId      String
  system        System          @relation(fields: [systemId], references: [id], onDelete: Cascade)
  // Null is the base review, otherwise the Review Group. Restrict: deleting a group must never erase or re-attribute its verdicts.
  reviewGroupId String?
  reviewGroup   ReviewGroup?    @relation(fields: [reviewGroupId], references: [id], onDelete: Restrict)
  verdictById   String
  verdictBy     User            @relation(fields: [verdictById], references: [id])
  verdict       EvaluationTrack
  comment       String
  givenAt       DateTime        @default(now())
  voidedAt      DateTime?
  // Why it was voided when an edit reopened it ("A.5.1 changed after the verdict"); null for a live verdict and for a dropped participant's.
  voidReason    String?

  @@index([systemId])
}

// What the Business System Owner decides at a gate (#330): OG3 is built; Qualification and OG2 (#331) reuse the model.
enum GateOutcome {
  AUTHORIZE
  REJECT
  SEND_BACK
}

// One decision at a gate of a staged System (#330, PRD 0002 F-ST.5-7): who decided, what, and the comment (required). Kept for good
// (a send-back lets the System reach the gate again, so a System can have several). `sentBackTo` is the stage a SEND_BACK returned to.
model GateDecision {
  id            String           @id @default(cuid())
  systemId      String
  system        System           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  gate          EvaluationStage
  outcome       GateOutcome
  sentBackTo    EvaluationStage?
  comment       String
  // The written justification for proceeding at OG2 against an Advise-against Recommendation (#331); null otherwise.
  justification String?
  decidedById   String
  decidedBy     User             @relation("GateDecisionDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime         @default(now())

  @@index([systemId])
}

// What an OAG group recommends (PRD 0002 F-OAG.1, #331).
enum RecommendationKind {
  RECOMMEND
  RECOMMEND_WITH_CONDITIONS
  ADVISE_AGAINST
}

// One OAG review Recommendation (#331, ADR 0014), as a `TrackVerdict` is for OG1: for the base review (`reviewGroupId` null) or a Review
// Group, shown as the group's, voided when an owner edit in the group's remit reopens it. `stage` is the OAG review it belongs to
// (OAG_REVIEW_1 before OG2; OAG_REVIEW_2 before OG3 is #332). Conditions are free text in the comment.
model Recommendation {
  id             String             @id @default(cuid())
  systemId       String
  system         System             @relation(fields: [systemId], references: [id], onDelete: Cascade)
  // Null for a Recommendation given on a Change Review (#334), which belongs to no stage.
  stage          EvaluationStage?
  // The Change Review it was given on (#334); null for an OAG review Recommendation.
  changeReviewId String?
  changeReview   ChangeReview?      @relation(fields: [changeReviewId], references: [id], onDelete: Cascade)
  // Null is the base review, otherwise the Review Group. Restrict: deleting a group must never erase or re-attribute its Recommendations.
  reviewGroupId  String?
  reviewGroup    ReviewGroup?       @relation(fields: [reviewGroupId], references: [id], onDelete: Restrict)
  givenById      String
  givenBy        User               @relation(fields: [givenById], references: [id])
  kind           RecommendationKind
  comment        String
  givenAt        DateTime           @default(now())
  voidedAt       DateTime?
  // Why it was voided when an edit reopened it; null for a live one and for a dropped participant's.
  voidReason     String?

  @@index([systemId])
  @@index([changeReviewId])
}

// What a Change Review on an Onboarded System is in (#334, PRD 0002 F-CR, ADR 0014).
enum ChangeReviewStatus {
  OPEN
  ACCEPTED
  REVOKED
}

// A review of an Onboarded System when a change to its Framework Scope or classification added Controls to an OAG group's remit.
// One is open at a time per System (a later change widens it, in the System's lock). The BSO closes it: ACCEPTED, or REVOKED (the
// ATO is revoked and the System sent back to `sentBackTo`, null for a System on the classic flow, which returns to Draft).
model ChangeReview {
  id              String                @id @default(cuid())
  systemId        String
  system          System                @relation(fields: [systemId], references: [id], onDelete: Cascade)
  status          ChangeReviewStatus    @default(OPEN)
  startedAt       DateTime              @default(now())
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       User?                 @relation("ChangeReviewDecider", fields: [decidedById], references: [id])
  decisionComment String?
  sentBackTo      EvaluationStage?
  controls        ChangeReviewControl[]
  recommendations Recommendation[]

  @@index([systemId])
}

// A Control a Change Review added to one participant's remit (`reviewGroupId` null is the base review): the groups that take
// part are the distinct ones here, and each recommends on just its Controls.
model ChangeReviewControl {
  id             String       @id @default(cuid())
  changeReviewId String
  changeReview   ChangeReview @relation(fields: [changeReviewId], references: [id], onDelete: Cascade)
  controlId      String
  control        Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  reviewGroupId  String?
  reviewGroup    ReviewGroup? @relation(fields: [reviewGroupId], references: [id], onDelete: Restrict)
  addedAt        DateTime     @default(now())

  @@index([changeReviewId])
}

enum ChangeEventAction {
  SYSTEM_SUBMITTED
  APPROVAL_DECIDED
  SYSTEM_ONBOARDED
  RISK_STATUS_CHANGED
  ASSESSMENT_STATUS_CHANGED
  QUERY_OPENED
  QUERY_REPLIED
  QUERY_RESOLVED
  CLASSIFICATION_CHANGED
  // System-less: evidence-bearing changes to the requirement database
  // (PRD 0001 F-CE.1). Schema only for now; emitted by the authoring
  // issue (#73).
  CONTROL_MAPPING_CHANGED
  FRAMEWORK_PUBLISHED
  // "system"-actor: the requirement database changed under a System (a Framework was
  // published, a Control Mapping or a Control's scoping changed) and its applicable
  // Controls moved (PRD 0001 F-AP.3, #87). Kept apart from CLASSIFICATION_CHANGED,
  // which is the owner changing the System's own classification.
  APPLICABILITY_RECOMPUTED
  // The System's owner or an Admin removed a stale Control Assessment (#109). The row is
  // deleted, so its last status, evidence and notes are kept only in this event's detail.
  ASSESSMENT_REMOVED
  // System-less: the status of an Organizational or Both Control's Organization Control
  // Implementation changed (PRD 0001 F-IN.7, F-CE.2, #122, #284). One event per change, actor
  // the User who made it. An Organizational Control writes nothing per System, because its
  // status counts live on every System with the Framework in scope. A Both Control's change
  // also writes per-System ASSESSMENT_STATUS_CHANGED events for the Systems whose effective
  // status moved (#121); its System-less event, written since #284, is the Organization-level
  // record that the Control's history on /organization/controls reads.
  ORGANIZATION_IMPLEMENTATION_CHANGED
  // The Provider's owner or an Admin added, changed or removed one of the Provider's
  // Control Offerings (PRD 0001 F-IN.2, F-CE.2, #123). System-scoped to the Provider,
  // actor the User who made the change. (Marking or unmarking a System as a Provider is
  // a CLASSIFICATION_CHANGED event.)
  CONTROL_OFFERING_CHANGED
  // System-less: a Compliance Manager or an Admin added, changed or cleared the exclusion
  // justification of a Control on the Statement of Applicability (PRD 0001 F-OUT.4, F-CE.1,
  // #150). One event per change, actor the User who made it, the Control code and the old
  // and new text in the detail.
  SOA_JUSTIFICATION_CHANGED
  // System-less: an Internal Auditor evaluated an answered Check-up as Conforming, Observation or
  // Nonconformity (PRD 0001 F-IA.6, F-CE.1, #156). One event per evaluation, actor the Internal
  // Auditor; the detail names the Internal Audit, the Control, the target (a System or the
  // Organization) and the outcome. System-less even for a System-level Check-up.
  CHECK_UP_EVALUATED
  // An approved Review Step went back to Open because a person edited a Control Assessment in its
  // remit (#200). System-scoped, actor the person who edited; the detail names the step and the Control.
  REVIEW_STEP_REOPENED
  // The System's owner or an Admin handed the System to another owner (#233). System-scoped, one
  // event per System changed, actor the User who changed it; the detail names the previous and the
  // new owner. Changing a System's owner in bulk writes one event per System.
  SYSTEM_OWNER_CHANGED
  // An Admin saved a new value for an App Setting (#240). System-less, actor the Admin; the detail
  // names the setting's key and its old and new value. Saving the value a setting already has writes none.
  APP_SETTING_CHANGED
  // A System was created (#245). System-scoped, actor the creator; the detail names the System.
  // Systems created before this value existed have none: the System page shows a "Created" entry
  // from `createdAt` instead (no backfill).
  SYSTEM_CREATED
  // A Risk was opened on a System (#245): logged by hand (actor the person), auto-opened by a "No"
  // Self-Assessment answer or by an Internal Auditor's Nonconformity (actor "system"). The detail names
  // the Risk, its severity and how it was opened. An Organization Risk (no System) writes none.
  RISK_LOGGED
  // A System's name, vendor or description was edited (#246): the detail has each changed field's old and new value.
  SYSTEM_DETAILS_CHANGED
  // The System's owner or an Admin set, changed or cleared the System's Business System Owner (#321). System-scoped,
  // actor the User who changed it; the detail names the previous and the new Business System Owner. Picking one at
  // creation writes one too (old none, new the pick), but saving the value it already has writes none.
  BUSINESS_SYSTEM_OWNER_CHANGED
  // A Risk Analysis was completed (#325): actor the User who completed it; the detail says when it was held and how many
  // Risks it reviewed and raised. Recording and editing one write no event of their own (the Risks raised in it each
  // write RISK_LOGGED), so the timeline shows a meeting once, when it is done.
  RISK_ANALYSIS_COMPLETED
  // A staged System moved to another evaluation stage (#328): created at the first round, submitted to OG1, or sent on by
  // OG1 with its Track (the detail says which). System-scoped, actor the person who caused it, or "system" when OG1 closed
  // because the last open participant left the review.
  EVALUATION_STAGE_CHANGED
  // The base review or a Review Group gave its OG1 verdict (#328). System-scoped, actor the person; the detail names the
  // participant, not the person (shown as the group's), the verdict and the comment.
  TRACK_VERDICT_GIVEN
  // An OG1 verdict went back to open because an owner edit changed a first-round Control in its remit (#328). System-scoped,
  // actor the person who edited; the detail names the participant and the Control.
  TRACK_VERDICT_REOPENED
  // The Business System Owner (or an Admin) decided a staged System at a gate (#330, OG3): authorized it to operate, rejected it
  // or sent it back. System-scoped, actor the person; the detail names the gate, the decision and the comment.
  GATE_DECIDED
  // An OAG group gave its Recommendation at an OAG review (#331). System-scoped, actor the person; the detail names the group, not the person.
  RECOMMENDATION_GIVEN
  // A Recommendation went back to open because an owner edit changed a Control in its remit (#331).
  RECOMMENDATION_REOPENED
  // A Change Review started on an Onboarded System (#334) because a change added Controls to a group's remit, or was widened by a
  // later change. System-scoped, actor the person who made the change; the detail names the groups and how many Controls.
  CHANGE_REVIEW_STARTED
  CHANGE_REVIEW_WIDENED
  // The Business System Owner (or an Admin) accepted a Change Review or revoked the ATO (#334). Actor the person; the detail has the comment.
  CHANGE_REVIEW_DECIDED
}

// A curated, System-lifecycle-relevant mutation record — feeds the landing
// page's "Recent updates" feed (see #58). Usually System-scoped; the
// System-less actions (systemId null) record evidence-bearing changes to the
// requirement database and to the Organization's own Control implementations
// (PRD 0001 F-CE.1, F-CE.2); a Provider's Control Offerings are System-scoped to the
// Provider (CONTROL_OFFERING_CHANGED, #123). Deliberately not a full audit
// trail: pure catalog-admin CRUD (Control/DeploymentFacet/BusinessUnit/
// Framework create/edit/delete) is out of scope, since this exists for role-relevant "what changed on this System"
// visibility, not compliance auditing. `actorId` is either a User id, or the
// literal string "system" for a transition the backend computed as a side
// effect of a different, human-initiated action (e.g. a Provider's
// status moving its dependents', or a Risk auto-opened by a "No" Self-Assessment
// answer) rather than a direct edit to that specific row — deliberately not a User
// relation, since "system" never matches a real User id.
model ChangeEvent {
  id        String            @id @default(cuid())
  // Null for System-less events (CONTROL_MAPPING_CHANGED, FRAMEWORK_PUBLISHED,
  // ORGANIZATION_IMPLEMENTATION_CHANGED).
  systemId  String?
  system    System?           @relation(fields: [systemId], references: [id], onDelete: Cascade)
  action    ChangeEventAction
  detail    String
  actorId   String
  createdAt DateTime          @default(now())

  @@index([systemId, createdAt])
  @@index([createdAt])
}

// Where an Internal Audit is in its life (PRD 0001 F-IA.1). DRAFT is the only state any code
// can reach yet: launching (#154) and closing (#158) move an audit on. The values are added now
// because Postgres can't use an enum value in the migration that adds it, so a later issue
// would otherwise need a migration of its own just to add one.
enum InternalAuditStatus {
  DRAFT
  LAUNCHED
  CLOSED
}

// A Check-up's answer to one question (PRD 0001 F-IA.4, #155). Its own enum, not
// SelfAssessmentAnswer, even though the values match today: a Check-up answer is an account given
// to an auditor, and the two can diverge.
enum CheckUpAnswer {
  YES
  NO
  NA
}

// An Internal Audit (PRD 0001 F-IA.1, #152): an Internal Auditor's plan to verify some Controls
// across some Systems and/or the Organization's own implementations. A draft sends nothing and
// owns no Check-up; it can be edited and deleted until launch (#154). Drafting writes no
// Change Event: F-CE.1 logs Check-ups being evaluated, not an audit being planned.
model InternalAudit {
  id                  String              @id @default(cuid())
  title               String
  scopeDescription    String              @default("")
  // A calendar date (UTC), the due date every Check-up of the audit will carry.
  dueDate             DateTime            @db.Date
  // Whether the Organization Control Implementations of the target Controls are audited too.
  includeOrganization Boolean             @default(false)
  status              InternalAuditStatus @default(DRAFT)
  // The Internal Auditor who created it. Restrict: the audit's authorship is part of the
  // record, so a User with audits can't be deleted from under them (no silent SetNull).
  createdById         String
  createdBy           User                @relation("InternalAuditCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  // Set together with status LAUNCHED (#154): when the audit was launched and by whom. Null while
  // a draft. Restrict, like the creator: who launched an audit is part of the record.
  launchedAt          DateTime?
  launchedById        String?
  launchedBy          User?               @relation("InternalAuditLauncher", fields: [launchedById], references: [id], onDelete: Restrict)
  // Set together with status CLOSED (#158): when the audit was closed and by whom. Null until then.
  // Restrict, like the creator and the launcher: who closed an audit is part of the record.
  closedAt            DateTime?
  closedById          String?
  closedBy            User?               @relation("InternalAuditCloser", fields: [closedById], references: [id], onDelete: Restrict)

  controls InternalAuditControl[]
  systems  InternalAuditSystem[]
  checkUps CheckUp[]

  @@index([createdById])
  @@index([launchedById])
  @@index([closedById])
}

// A target Control of an Internal Audit. An explicit join model, not an implicit many-to-many:
// the draft's questions (#154) hang off this audit-Control pair.
// Cascade on the Control: for a DRAFT the pair holds no evidence, so deleting the Control just
// takes it off the plan (the audit stays, even if that leaves it invalid until edited). Once the
// audit is launched its Check-ups point at this row with Restrict (see CheckUp), so a Control
// that has Check-ups can't be deleted. Postgres can't make a rule depend on the audit's status,
// so a launched audit's Control that produced no Check-up at all (it applied nowhere) can still
// be deleted with the Control, and then leaves the audit's list. Accepted for now (product-owner
// decision 10a of 2026-10-13, comment on #154).
model InternalAuditControl {
  id              String        @id @default(cuid())
  internalAuditId String
  internalAudit   InternalAudit @relation(fields: [internalAuditId], references: [id], onDelete: Cascade)
  controlId       String
  control         Control       @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  // The draft's questions for this Control, in order. Kept after launch as the plan's record; each
  // Check-up carries its own copy.
  questions InternalAuditQuestion[]
  // The Check-ups generated for this audit-Control pair (#154).
  checkUps  CheckUp[]

  @@unique([internalAuditId, controlId])
  @@index([controlId])
}

// One question the Internal Auditor wrote (or took over from the Control's Self-Assessment
// Question) for a target Control of a draft (#154), in `position` order. The draft's own copy:
// it does not follow later edits to the Control. Launch copies the list into each Check-up.
model InternalAuditQuestion {
  id                     String               @id @default(cuid())
  internalAuditControlId String
  internalAuditControl   InternalAuditControl @relation(fields: [internalAuditControlId], references: [id], onDelete: Cascade)
  position               Int
  text                   String
  createdAt              DateTime             @default(now())

  @@unique([internalAuditControlId, position])
}

// A System picked for an Internal Audit: the resolved System, never a filter (#153 resolves a
// filter to rows here). Same explicit-join and Cascade-for-a-draft reasoning, and the same
// caveat for launched audits, as InternalAuditControl.
model InternalAuditSystem {
  id              String        @id @default(cuid())
  internalAuditId String
  internalAudit   InternalAudit @relation(fields: [internalAuditId], references: [id], onDelete: Cascade)
  systemId        String
  system          System        @relation(fields: [systemId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([internalAuditId, systemId])
  @@index([systemId])
}

// A request generated when an Internal Audit is launched (PRD 0001 F-IA.3, #154): the audit asks
// the current recipient to answer the questions about one Control for one target. The target is
// the System's Control Assessment when `systemId` is set, or the Control's Organization Control
// Implementation when it is null. The recipient is NOT stored: it is the System's owner, or the
// Control's Control Owner, *now* (#155), so a Check-up follows a change of owner. The due date is
// the audit's: a launched audit can't be edited, so reading it from there can't drift. Answers,
// evaluation and withdrawal arrive with #155, #156 and #158.
// Everything here is Restrict: a launched audit is evidence, so a Control, a System or the audit
// itself can't be deleted from under its Check-ups (product-owner decision 9a of 2026-10-13, comment on #154).
// (internalAuditId, controlId) must be a target
// pair of the audit, which the composite relation to InternalAuditControl enforces.
// At most one Check-up per audit, Control and target: the unique below covers System targets (NULLs
// are distinct in a Postgres unique index), and a partial unique index covering `systemId IS NULL`
// is written by hand in the migration ("CheckUp_organization_target_key"); Prisma's schema language
// can't express it, and `migrate diff` ignores partial indexes.
model CheckUp {
  id                   String               @id @default(cuid())
  internalAuditId      String
  internalAudit        InternalAudit        @relation(fields: [internalAuditId], references: [id], onDelete: Restrict)
  controlId            String
  control              Control              @relation(fields: [controlId], references: [id], onDelete: Restrict)
  internalAuditControl InternalAuditControl @relation(fields: [internalAuditId, controlId], references: [internalAuditId, controlId], onDelete: Restrict)
  // The target System, or null for the Organization-level Check-up.
  systemId             String?
  system               System?              @relation(fields: [systemId], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())

  // The Check-up's own copy of the questions, taken at launch.
  questions  CheckUpQuestion[]
  // Present once the recipient has answered (#155); its existence is what "answered" means.
  response   CheckUpResponse?
  // Present once an Internal Auditor has evaluated it (#156); its existence is what "evaluated" means.
  evaluation CheckUpEvaluation?
  // Present once an Internal Auditor has withdrawn it (#158); its existence is what "withdrawn" means.
  withdrawal CheckUpWithdrawal?
  // The Risk a Nonconformity opened (#157); null for any other outcome and before the evaluation.
  risk       Risk?

  @@unique([internalAuditId, controlId, systemId])
  @@index([controlId])
  @@index([systemId])
}

// A question of a Check-up, copied at launch from the draft's list so that editing a Control (its
// Self-Assessment Question or anything else) afterwards doesn't change what was asked.
model CheckUpQuestion {
  id        String   @id @default(cuid())
  checkUpId String
  checkUp   CheckUp  @relation(fields: [checkUpId], references: [id], onDelete: Cascade)
  position  Int
  text      String
  createdAt DateTime @default(now())

  answer CheckUpResponseAnswer?

  @@unique([checkUpId, position])
}

// The recipient's response to a Check-up (PRD 0001 F-IA.4, #155): one per Check-up, and its
// existence is what makes the Check-up "answered". It holds who answered and when, who last changed
// it, and the evidence links of the response as a whole (links only, no upload). The answers
// themselves are CheckUpResponseAnswer rows, one per question. Evaluation (#156) and withdrawal
// (#158) will add their own tables or columns beside this one; nothing here changes for them.
// Both users are Restrict: who answered is part of the audit evidence, so a User with responses
// can't be deleted from under them.
model CheckUpResponse {
  id              String   @id @default(cuid())
  checkUpId       String   @unique
  checkUp         CheckUp  @relation(fields: [checkUpId], references: [id], onDelete: Cascade)
  // Who first submitted it and when.
  respondedById   String
  respondedBy     User     @relation("CheckUpResponder", fields: [respondedById], references: [id], onDelete: Restrict)
  respondedAt     DateTime @default(now())
  // Who changed it last (the submitter again on the first submission) and when.
  lastChangedById String
  lastChangedBy   User     @relation("CheckUpResponseChanger", fields: [lastChangedById], references: [id], onDelete: Restrict)
  updatedAt       DateTime @updatedAt
  // Absolute http(s) URLs, validated on write and again on read before they become links.
  evidenceLinks   String[] @default([])

  answers CheckUpResponseAnswer[]

  @@index([respondedById])
  @@index([lastChangedById])
}

// How an Internal Auditor judged an answered Check-up (PRD 0001 F-IA.6, #156).
enum CheckUpOutcome {
  // The answer is borne out.
  CONFORMING
  // A weakness worth noting that is not a failure of the Control.
  OBSERVATION
  // The Control does not work as claimed. (A follow-up, #157, acts on it; today it only records it.)
  NONCONFORMITY
}

// An Internal Auditor's evaluation of a Check-up (PRD 0001 F-IA.6, #156): one per Check-up at most,
// and its existence is what makes the Check-up "evaluated". It is final: once recorded it is never
// changed, and it locks the Check-up's response. Beside CheckUpResponse, not on it, so #157 can
// link a Risk to it and #158 can test "neither evaluated nor withdrawn" with two existence checks.
// Who evaluated is part of the audit evidence, so the User is Restrict like the response's users.
model CheckUpEvaluation {
  id            String         @id @default(cuid())
  checkUpId     String         @unique
  checkUp       CheckUp        @relation(fields: [checkUpId], references: [id], onDelete: Cascade)
  outcome       CheckUpOutcome
  // Required for an Observation and a Nonconformity (application rule), optional for Conforming.
  comment       String         @default("")
  evaluatedById String
  evaluatedBy   User           @relation("CheckUpEvaluator", fields: [evaluatedById], references: [id], onDelete: Restrict)
  evaluatedAt   DateTime       @default(now())

  @@index([evaluatedById])
}

// A Check-up an Internal Auditor withdrew (PRD 0001 F-IA.8, #158): one per Check-up at most, and its
// existence is what "withdrawn" means, beside CheckUpEvaluation's existence meaning "evaluated"
// (closing an audit tests "neither evaluated nor withdrawn" with those two existence checks). A
// withdrawal is final: the application never updates or deletes it (decision 2a, #158). The reason
// is required (non-blank, at most 2000 characters; application rules). A withdrawn Check-up keeps
// any response it had, as part of the record. Who withdrew is audit evidence, so the User is Restrict.
model CheckUpWithdrawal {
  id            String   @id @default(cuid())
  checkUpId     String   @unique
  checkUp       CheckUp  @relation(fields: [checkUpId], references: [id], onDelete: Cascade)
  reason        String
  withdrawnById String
  withdrawnBy   User     @relation("CheckUpWithdrawer", fields: [withdrawnById], references: [id], onDelete: Restrict)
  withdrawnAt   DateTime @default(now())

  @@index([withdrawnById])
}

// The answer to one question of a Check-up: Yes / No / N/A with a free-text description.
model CheckUpResponseAnswer {
  id          String          @id @default(cuid())
  responseId  String
  response    CheckUpResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String          @unique
  question    CheckUpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer      CheckUpAnswer
  description String          @default("")

  @@index([responseId])
}

// An anonymous thumbs-up on a design proposal on the public /design landing page (#186). The
// voter is a random UUID the browser keeps; there is no User behind it. proposalId is the id used
// in public/design/proposals.js and is deliberately not a foreign key: proposals are static pages.
model DesignVote {
  id         String   @id @default(cuid())
  proposalId String
  voterId    String
  createdAt  DateTime @default(now())

  @@unique([proposalId, voterId])
  @@index([voterId])
}

// One figure on a User's Home page as it stood on one UTC day (#227), recorded once a day by the
// stat-snapshots cron so the stat cards' trend lines can be exact. Per User because the figures differ by
// role and scope. `statKey` is the stat card's label and `value` its number ("Oldest waiting" is in days,
// "none" is 0). `role` is the User's role when recorded: a figure's scope depends on it, so only rows of the current role are read. No pruning today: see STAT_SNAPSHOT_RETENTION_DAYS in src/lib/stat-snapshots.ts.
model StatSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statKey   String
  role      UserRole
  value     Int
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, statKey, day])
}

// An Admin-editable setting of the app (#240), e.g. the Systems list's thresholds. Each setting is declared
// once in code (`src/lib/app-settings.ts`: key, label, type, range, default); a key with no row uses its
// default, so this table starts empty and production behaves as before until an Admin saves. `value` is the
// setting's JSON value, checked against that declaration on every read and write. The User who last
// changed it is kept for the page; a deleted User leaves it null.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// The way a System is evaluated (PRD 0002): Self (self-assessment) or Full. Chosen per System at OG1 in a later
// issue; for now only Document Requirements name Tracks.
enum EvaluationTrack {
  SELF
  FULL
}

// Where a staged System is in its evaluation (PRD 0002 section 5, #328). The whole flow is declared now so the later stage
// issues need no enum migration; only FIRST_ROUND, OG1, QUALIFICATION and SECOND_ROUND are reached so far. Risk Analysis is
// a step of the first round, not a stage. The Self track goes OG1 to SECOND_ROUND, the Full track OG1 to QUALIFICATION,
// FIRST_DOCUMENTATION, OAG_REVIEW_1, OG2, SECOND_ROUND, OAG_REVIEW_2 and OG3 (the Self track reaches OG3 after its second round).
enum EvaluationStage {
  FIRST_ROUND
  OG1
  QUALIFICATION
  FIRST_DOCUMENTATION
  OAG_REVIEW_1
  OG2
  SECOND_ROUND
  RISK_ANALYSIS_2
  OAG_REVIEW_2
  OG3
}

// The documentation stage that needs a Document Requirement. First documentation is a Full-track stage.
enum DocumentationStage {
  FIRST_DOCUMENTATION
  SECOND_ROUND
}

// What a System must provide besides answering its Controls (PRD 0002 F-DOC.1, #323), such as an architecture
// description or a DPIA: a catalogue the Compliance Manager or an Admin curates. Each says at which stage it is
// needed and on which Tracks (at least one). First documentation is a Full-track stage, so a requirement for it
// never includes Self; the API refuses that and a CHECK constraint backs it up. What a System has provided against
// each one is a SystemDocument, which goes with the entry (#324). Curation is not a Change Event.
model DocumentRequirement {
  id              String             @id @default(cuid())
  name            String             @unique
  description     String?
  stage           DocumentationStage
  tracks          EvaluationTrack[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  systemDocuments SystemDocument[]
}

// What one System has provided against one Document Requirement (#324, PRD 0002 F-DOC.2): a link to the document and
// whether it is marked provided (which needs a link or an uploaded file). No row means not provided. Written by the System's owner or an Admin; the row records
// who and when, and no Change Event is written. Deleted with the System or with the catalogue entry.
model SystemDocument {
  id                    String              @id @default(cuid())
  systemId              String
  system                System              @relation(fields: [systemId], references: [id], onDelete: Cascade)
  documentRequirementId String
  documentRequirement   DocumentRequirement @relation(fields: [documentRequirementId], references: [id], onDelete: Cascade)
  link                  String?
  provided              Boolean             @default(false)
  updatedAt             DateTime            @updatedAt
  updatedById           String?
  updatedBy             User?               @relation("SystemDocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  file                  SystemDocumentFile?

  @@unique([systemId, documentRequirementId])
  @@index([documentRequirementId])
}

// The one file a System uploaded for a Document Requirement (#324): provided is a link or a file, or both. The bytes
// live here, in Postgres, apart from SystemDocument so that listing never reads them. A new upload replaces the file;
// it goes with its SystemDocument. The 4 MB cap is the app's (Vercel refuses larger request bodies).
model SystemDocumentFile {
  id               String         @id @default(cuid())
  systemDocumentId String         @unique
  systemDocument   SystemDocument @relation(fields: [systemDocumentId], references: [id], onDelete: Cascade)
  fileName         String
  contentType      String
  size             Int
  data             Bytes
  uploadedAt       DateTime       @default(now())
  uploadedById     String?
  uploadedBy       User?          @relation("SystemDocumentFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
}
