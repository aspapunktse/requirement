generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

enum RequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
  NOT_APPLICABLE
  WAIVED
}

// The System Owner's answer to a Requirement's Self-Assessment Question —
// recorded alongside RequirementStatus, not a replacement for it. Yes/No/NA
// map to Fulfilled/left-open-plus-Risk/Not Applicable respectively.
enum SelfAssessmentAnswer {
  YES
  NO
  NA
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  TRANSFERRED
  CLOSED
}

enum UserRole {
  ADMIN
  RISK_OWNER
  SYSTEM_OWNER
  REVIEWER
  VIEWER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          UserRole @default(VIEWER)
  createdAt     DateTime @default(now())

  ownedSystems      System[]              @relation("SystemOwner")
  assessments       RequirementAssessment[] @relation("AssessedBy")
  riskActions       Risk[]                @relation("RiskOwner")
  approvals         Approval[]
}

// A system or cloud solution being onboarded into the enterprise.
model System {
  id              String            @id @default(cuid())
  name            String
  vendor          String?
  description     String?
  status          OnboardingStatus  @default(DRAFT)
  dataClassification String?        // e.g. Public, Internal, Confidential, Restricted
  ownerId         String
  owner           User              @relation("SystemOwner", fields: [ownerId], references: [id])
  // One or more deployment facets this System spans (e.g. On-Prem, Cloud) —
  // a Hybrid System is simply one that declares more than one. See ADR 0003.
  deploymentFacets DeploymentFacet[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  // When the System was actually marked Onboarded — distinct from Approval
  // (a judgment call) and from updatedAt (touched by unrelated edits). See
  // ADR 0001.
  onboardedAt     DateTime?

  assessments     RequirementAssessment[]
  risks           Risk[]
  approvals       Approval[]
  // Centrally-managed dependencies this System declares it consumes. Purely
  // declarative in this ticket — auto-fulfilling mapped Requirements is #16.
  capabilities    Capability[]
}

// An admin-curated deployment classification (e.g. On-Premises Datacenter,
// Cloud IaaS/PaaS, SaaS) that determines which Requirements apply to a
// System. A System declares one or more facets — Hybrid is simply a System
// with more than one declared, not its own catalog entry. See ADR 0003
// (which supersedes ADR 0002's single-select-only design).
model DeploymentFacet {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())

  // Requirements scoped to this facet. A Requirement with no rows here at
  // all applies regardless of facet (see Requirement.deploymentFacets).
  requirements Requirement[]
  systems      System[]
}

// An admin-curated, centrally-provided dependency (e.g. Active Directory,
// a central IAM/SSO platform, a central KMS) a System can declare it
// consumes. Standalone catalog concept — not a reference to any actual
// onboarded System, even if the same real-world thing is also tracked
// as a System elsewhere.
model Capability {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())

  // Requirements this Capability auto-fulfills when a System declares it.
  requirements Requirement[]
  // Systems that have declared this Capability as consumed.
  systems      System[]
  // RequirementAssessments currently auto-fulfilled by this Capability.
  autoFulfilledAssessments RequirementAssessment[]
}

enum RequirementApplicability {
  ORGANIZATIONAL
  PER_SYSTEM
  BOTH
}

// A reusable requirement definition (security, legal, compliance, operational, etc.)
model Requirement {
  id            String                   @id @default(cuid())
  code          String                   @unique // e.g. SEC-001
  title         String
  description   String
  category      String                   // e.g. Security, Privacy, Legal, Operational
  framework     String?                  // e.g. ISO27001, NIST-CSF, internal policy ref
  mandatory     Boolean                  @default(true)
  applicability RequirementApplicability
  question      String?                  // self-assessment question; null for ORGANIZATIONAL-only requirements
  intent        String?                  // why the question matters, shown alongside it
  examples      String[]                 // example ways to satisfy the requirement
  createdAt     DateTime                 @default(now())

  assessments   RequirementAssessment[]

  // Deployment Facets this Requirement is scoped to. Empty means "applies
  // regardless of facet" (how the Annex A seed ships). Must stay empty for
  // ORGANIZATIONAL requirements, which are never assessed per System.
  deploymentFacets DeploymentFacet[]
  // Capabilities that, if a System declares one, auto-fulfill this
  // Requirement. May be empty, one, or several (any one suffices).
  capabilities  Capability[]
}

// Fulfillment status of a Requirement for a specific System.
model RequirementAssessment {
  id             String             @id @default(cuid())
  systemId       String
  system         System             @relation(fields: [systemId], references: [id], onDelete: Cascade)
  requirementId  String
  requirement    Requirement        @relation(fields: [requirementId], references: [id])
  status         RequirementStatus  @default(NOT_STARTED)
  evidence       String?            // link or note to supporting evidence
  notes          String?
  // The System Owner's Yes/No/N/A answer to the Requirement's Self-
  // Assessment Question, if it's been answered. Distinct from `status`:
  // both are shown, and manual status edits don't touch this field.
  selfAssessmentAnswer SelfAssessmentAnswer?
  assessedById   String?
  assessedBy     User?              @relation("AssessedBy", fields: [assessedById], references: [id])
  assessedAt     DateTime?
  updatedAt      DateTime           @updatedAt
  // Set when this Assessment was auto-fulfilled by a declared Capability
  // (see #16) rather than by a human. Non-null means "eligible for
  // automatic reversion if that Capability is un-declared" — any manual
  // edit to this Assessment clears it, which is what makes the row immune
  // to future automatic reversion and marks it as human-owned going forward.
  fulfilledByCapabilityId String?
  fulfilledByCapability   Capability? @relation(fields: [fulfilledByCapabilityId], references: [id])

  // Risks auto-opened by answering "No" to this Requirement's Self-
  // Assessment Question.
  originatedRisks Risk[]

  @@unique([systemId, requirementId])
}

// A risk identified during onboarding of a System.
model Risk {
  id            String       @id @default(cuid())
  systemId      String
  system        System       @relation(fields: [systemId], references: [id], onDelete: Cascade)
  title         String
  description   String
  severity      RiskSeverity
  likelihood    RiskSeverity
  status        RiskStatus   @default(OPEN)
  mitigationPlan String?
  ownerId       String?
  owner         User?        @relation("RiskOwner", fields: [ownerId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Set when this Risk was auto-opened by a "No" answer to a Requirement's
  // Self-Assessment Question, rather than logged ad-hoc. Null for ad-hoc Risks.
  requirementAssessmentId String?
  requirementAssessment   RequirementAssessment? @relation(fields: [requirementAssessmentId], references: [id])
}

// Formal sign-off record on a System's onboarding.
model Approval {
  id          String   @id @default(cuid())
  systemId    String
  system      System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User     @relation(fields: [approverId], references: [id])
  decision    OnboardingStatus
  comment     String?
  decidedAt   DateTime @default(now())
}
